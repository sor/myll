class Init
{
	field
	{
		i32 dontInit = uninit;  // alt.: var = --, var = void // null would not work, as it would init a ptr
		i32 lateInit = late;    // alt.: var = later
	}
}

[pack=4, align=8]
class PackAndAlign
{
	field f32* iptr;
	field f32  f;
}
var PackAndAlign pna;

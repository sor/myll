module plasma;

//[inline]
func plasma(f32 x, f32 y, f32 time) -> f32
{
	const f32 cx = x * 0.1 + 0.5 * sin(time / 5.0);
	const f32 cy = y * 0.1 + 0.5 * cos(time / 3.0);
	var f32 v = 0.0;
	v += sin((x + time));
	v += sin((y + time) / 2.0);
	v += sin((x + y + time) / 2.0);
	v += sin(sqrt((cx*cx + cy*cy) * 100.0 + 1.0) + time);
	v = v / 2.0;
	return v;
}

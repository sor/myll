module cxxopts;
import std_string, std_vector;
import "cxxopts.hpp";

namespace cxxopts {
	class Options {
	[pub]:
		ctor( const std::string & program, const std::string & help );

		func parse( int argc, const char *[] argv ) -> ParseResult;
		func add_options() -> OptionAdder;
	};

	class ParseResult {
	[pub]:
		func unmatched() -> std::vector<std::string>;
		func count( const std::string & name ) -> int;

		operator []( const std::string & name ) -> Value &;
	};

	class Value {
	[pub]:
		func default_value( const std::string & value ) -> Value &;
		func as<T>() -> T;
	};

	class OptionAdder {
	[pub]:
		operator ()( const std::string & option, const std::string & desc ) -> OptionAdder &;
		operator ()( const std::string & option, const std::string & desc, const Value * value ) -> OptionAdder &;
	};

	func value<T>() -> Value *;
}

module grep_cxxopts;

import std_iostream, std_fstream, std_string, std_vector, c_ctype, cxxopts.hpp;

struct Options
{
	field bool ignore_case;
	field bool invert;
	field bool line_number;
	field bool count;
	field bool list_files;
	field bool whole_line;
	field bool no_filename;
	field bool with_filename;
	field string pattern;
};

func usage() -> int
{
	std::cerr << "usage: grep_cxxopts [options] pattern [file...]\n"
	          << "options: -e pattern  -i  -v  -n  -c  -l  -x  -H  -h\n";
	return 1;
}

func charEquals( const char a, const char b, const bool ignore_case ) -> bool
{
	if( !ignore_case )
		return a == b;
	return std::tolower( a ) == std::tolower( b );
}

func stringEquals( const string & a, const string & b, const bool ignore_case ) -> bool
{
	if( a.length() != b.length() )
		return false;

	var usize i = 0;
	while( i < a.length() ) {
		if( !charEquals( a[i], b[i], ignore_case ) )
			return false;
		++i;
	}
	return true;
}

func contains( const string & haystack, const string & needle, const bool ignore_case ) -> bool
{
	if( needle.length() == 0 )
		return true;
	if( needle.length() > haystack.length() )
		return false;

	const usize last = haystack.length() - needle.length();
	var usize i = 0;
	while( i <= last ) {
		var usize j = 0;
		while( j < needle.length() ) {
			if( !charEquals( haystack[i + j], needle[j], ignore_case ) )
				break;
			++j;
		}
		if( j == needle.length() )
			return true;
		++i;
	}
	return false;
}

func matches( const string & line, const string & pattern, const bool whole_line,
	const bool ignore_case ) -> bool
{
	if( whole_line )
		return stringEquals( line, pattern, ignore_case );
	return contains( line, pattern, ignore_case );
}

func grepStream( const string & file_name, std::istream & in, const Options & opts,
	const bool print_name ) -> int
{
	var string line;
	var int line_no = 0;
	var int match_count = 0;

	while( std::getline( in, line ) ) {
		++line_no;
		var bool matched = matches( line, opts.pattern, opts.whole_line, opts.ignore_case );
		if( opts.invert )
			matched = !matched;

		if( !matched )
			continue;

		++match_count;

		if( opts.list_files ) {
			std::cout << file_name << "\n";
			return 0;
		}

		if( opts.count )
			continue;

		if( print_name )
			std::cout << file_name << ":";
		if( opts.line_number )
			std::cout << line_no << ":";
		std::cout << line << "\n";
	}

	if( opts.count ) {
		if( print_name )
			std::cout << file_name << ":";
		std::cout << match_count << "\n";
	}

	return 0;
}

func main( const int argc, const char *[] argv ) -> int
{
	var cxxopts::Options cxx = cxxopts::Options( "grep_cxxopts", "grep with cxxopts" );
	cxx.add_options()
		( "i,ignore-case", "Ignore case", cxxopts::value<bool>()->default_value( "false" ) )
		( "v,invert-match", "Invert match", cxxopts::value<bool>()->default_value( "false" ) )
		( "n,line-number", "Show line numbers", cxxopts::value<bool>()->default_value( "false" ) )
		( "c,count", "Count matches", cxxopts::value<bool>()->default_value( "false" ) )
		( "l,files-with-matches", "List files with matches",
		  cxxopts::value<bool>()->default_value( "false" ) )
		( "x,line-regexp", "Match whole lines", cxxopts::value<bool>()->default_value( "false" ) )
		( "H,with-filename", "Print filename", cxxopts::value<bool>()->default_value( "false" ) )
		( "h,no-filename", "Suppress filename", cxxopts::value<bool>()->default_value( "false" ) )
		( "e,regexp", "Pattern", cxxopts::value<string>() );

	var cxxopts::ParseResult result = cxx.parse( argc, argv );

	var Options opts = Options();
	opts.ignore_case = result["ignore-case"].as<bool>();
	opts.invert = result["invert-match"].as<bool>();
	opts.line_number = result["line-number"].as<bool>();
	opts.count = result["count"].as<bool>();
	opts.list_files = result["files-with-matches"].as<bool>();
	opts.whole_line = result["line-regexp"].as<bool>();
	opts.with_filename = result["with-filename"].as<bool>();
	opts.no_filename = result["no-filename"].as<bool>();

	if( result.count( "regexp" ) != 0 ) {
		opts.pattern = result["regexp"].as<string>();
	}

	const std::vector<string> positional = result.unmatched();
	var usize pos = 0;

	if( opts.pattern == "" ) {
		if( positional.size() == 0 )
			return usage();
		opts.pattern = positional[pos];
		++pos;
	}

	var bool print_name = false;
	if( !opts.no_filename ) {
		if( opts.with_filename )
			print_name = true;
		else if( positional.size() - pos > 1 )
			print_name = true;
	}

	if( pos >= positional.size() ) {
		return grepStream( "-", std::cin, opts, print_name );
	}

	while( pos < positional.size() ) {
		const string path = positional[pos];
		if( path == "-" ) {
			grepStream( "-", std::cin, opts, print_name );
		}
		else {
			var std::ifstream file = std::ifstream( path );
			if( !file ) {
				std::cerr << "grep_cxxopts: " << path << ": cannot open file\n";
				return 1;
			}
			grepStream( path, file, opts, print_name );
		}
		++pos;
	}

	return 0;
}

module basename;

import std_iostream, std_filesystem;

func main( const int argc, const char *[] argv ) -> int
{
	if( argc < 2 ) {
		std::cerr << "basename: missing operand\n";
		return 1;
	}

	const string path = (string)argv[1];
	var string base = (string)std::filesystem::path(path).filename().generic_string();

	if( argc == 3 ) {
		const string suffix = (string)argv[2];
		const usize suffix_len = suffix.length();
		if( base.length() >= suffix_len && base.compare(base.length() - suffix_len, suffix_len, suffix) == 0 )
			base = base.substr(0, base.length() - suffix_len);
	}

	std::cout << base << "\n";
	return 0;
}

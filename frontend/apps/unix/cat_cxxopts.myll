module cat_cxxopts;

import std_iostream, std_fstream, std_vector, cxxopts.hpp;

func copyStream( std::istream & in ) -> void
{
	std::cout << in.rdbuf();
}

func main( const int argc, const char *[] argv ) -> int
{
	var cxxopts::Options options = cxxopts::Options( "cat_cxxopts", "cat with cxxopts" );
	var cxxopts::ParseResult result = options.parse( argc, argv );
	const std::vector<string> files = result.unmatched();

	var usize i = 0;
	if( files.size() == 0 ) {
		copyStream( std::cin );
		return 0;
	}

	while( i < files.size() ) {
		const string path = files[i];
		if( path == "-" ) {
			copyStream( std::cin );
		}
		else {
			var std::ifstream file = std::ifstream( path );
			if( !file ) {
				std::cerr << "cat_cxxopts: " << path << ": cannot open file\n";
				return 1;
			}
			copyStream( file );
		}
		++i;
	}

	return 0;
}

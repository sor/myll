module dirname;

import std_iostream, std_filesystem;

func main( const int argc, const char *[] argv ) -> int
{
	if( argc < 2 ) {
		std::cerr << "dirname: missing operand\n";
		return 1;
	}

	const string path = (string)argv[1];
	var string dir = (string)std::filesystem::path(path).parent_path().generic_string();

	if( dir == "" )
		dir = ".";

	std::cout << dir << "\n";
	return 0;
}

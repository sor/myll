module ls;

import std_iostream, std_filesystem, std_vector, std_string, std_algorithm, ls_helpers.hpp;

enum SortMode {
	Name,
	Size,
	Time,
}

class DirEntry
{
	field {
		std::filesystem::path               _path;
		u64                                 _size = 0;
		std::filesystem::file_time_type     _time;
		bool                                _isDirectory = false;
	}

[pub]:
	ctor( const std::filesystem::path & path )
	{
		_path = path;
		_isDirectory = std::filesystem::is_directory( _path );
		try {
			_time = std::filesystem::last_write_time( _path );
		}
		catch() {
			_time = std::filesystem::file_time_type::min();
		}
		if( !_isDirectory ) {
			try {
				_size = std::filesystem::file_size( _path );
			}
			catch() {
				_size = 0;
			}
		}
	}

	[pure]
	func path() -> string => (string)_path.generic_string();

	[pure]
	func name() -> string => (string)_path.filename().generic_string();

	[pure]
	func size() -> u64 => _size;

	[pure]
	func time() -> std::filesystem::file_time_type => _time;

	[pure]
	func isDirectory() -> bool => _isDirectory;
}

struct Options
{
	field bool showAll;
	field bool almostAll;
	field bool nameOnly;
	field bool humanReadable;
	field bool longFormat;
	field bool recursive;
	field bool reverse;
	field SortMode sortMode;
}

class Formatter
{
[pub]:
	[virtual]
	func format( const DirEntry & e ) -> string
	{
		if( e.name().length() == 0 )
			return "";
		return "";
	}
}

func humanSize( u64 bytes ) -> string
{
	if( bytes >= 1024 * 1024 * 1024 )
		return std::to_string( bytes / (1024 * 1024 * 1024) ) + "G";
	if( bytes >= 1024 * 1024 )
		return std::to_string( bytes / (1024 * 1024) ) + "M";
	if( bytes >= 1024 )
		return std::to_string( bytes / 1024 ) + "K";
	return std::to_string( bytes );
}

func padLeft( string s, usize width ) -> string
{
	while( s.length() < width )
		s = " " + s;
	return s;
}

class LongFormatter : Formatter
{
	field bool _humanReadable = false;

[pub]:
	ctor( bool humanReadable )
	{
		_humanReadable = humanReadable;
	}

	[override]
	func format( const DirEntry & e ) -> string
	{
		var string sizeStr = _humanReadable
			? humanSize( e.size() )
			: std::to_string( e.size() );

		return ls_helpers::fileTypeLetter( e.path() )
			+ ls_helpers::permissionString( e.path() )
			+ " " + padLeft( std::to_string( ls_helpers::hardLinkCount( e.path() ) ), 2 )
			+ " " + ls_helpers::ownerName( e.path() )
			+ " " + ls_helpers::groupName( e.path() )
			+ " " + padLeft( sizeStr, 10 )
			+ " " + ls_helpers::formatTime( e.path() )
			+ " " + e.name()
			+ "\n";
	}
}

class DetailedFormatter : Formatter
{
	field bool _humanReadable = false;

[pub]:
	ctor( bool humanReadable )
	{
		_humanReadable = humanReadable;
	}

	[override]
	func format( const DirEntry & e ) -> string
	{
		var string s = (_humanReadable ? humanSize( e.size() ) : std::to_string( e.size() ))
			+ " " + e.name();
		if( e.isDirectory() )
			s += "/";
		return s + "\n";
	}
}

class NameOnlyFormatter : Formatter
{
[pub]:
	[override]
	func format( const DirEntry & e ) -> string
	{
		var string s = e.name();
		if( e.isDirectory() )
			s += "/";
		return s + "\n";
	}
}

func entryNameLess( const DirEntry & a, const DirEntry & b ) -> bool
{
	return a.name() < b.name();
}

func entrySizeLess( const DirEntry & a, const DirEntry & b ) -> bool
{
	if( a.size() != b.size() )
		return a.size() > b.size();
	return a.name() < b.name();
}

func entryTimeLess( const DirEntry & a, const DirEntry & b ) -> bool
{
	if( a.time() != b.time() )
		return a.time() > b.time();
	return a.name() < b.name();
}

func isHidden( const DirEntry & e ) -> bool
{
	return e.name().length() > 0 && e.name().compare( 0, 1, "." ) == 0;
}

func isDotOrDotDot( const DirEntry & e ) -> bool
{
	return e.name() == "." || e.name() == "..";
}

func shouldShow( const DirEntry & e, const Options & options ) -> bool
{
	if( isDotOrDotDot( e ) )
		return options.showAll;
	return options.showAll || options.almostAll || !isHidden( e );
}

func listPath( const std::filesystem::path & target, const Options & options, Formatter *! & fmt, bool printHeader ) -> int
{
	if( !std::filesystem::exists( target ) ) {
		std::cerr << "ls: " << target.generic_string() << ": No such file or directory\n";
		return 1;
	}

	if( !std::filesystem::is_directory( target ) ) {
		var DirEntry e = DirEntry( target );
		std::cout << fmt->format( e );
		return 0;
	}

	if( printHeader )
		std::cout << target.generic_string() << ":\n";

	var std::vector<DirEntry> entries = std::vector<DirEntry>();

	var std::filesystem::directory_iterator it  = std::filesystem::directory_iterator( target );
	var std::filesystem::directory_iterator end = std::filesystem::directory_iterator();

	while( it != end ) {
		entries.push_back( DirEntry( (*it).path() ) );
		++it;
	}

	if( options.sortMode == SortMode::Name )
		std::sort( entries.begin(), entries.end(), entryNameLess );
	else if( options.sortMode == SortMode::Size )
		std::sort( entries.begin(), entries.end(), entrySizeLess );
	else
		std::sort( entries.begin(), entries.end(), entryTimeLess );

	if( options.reverse )
		std::reverse( entries.begin(), entries.end() );

	var usize k = 0;
	while( k < entries.size() ) {
		if( shouldShow( entries[k], options ) )
			std::cout << fmt->format( entries[k] );
		++k;
	}
	else {
		std::cout << "total 0\n";
	}

	if( options.recursive ) {
		var usize j = 0;
		while( j < entries.size() ) {
			if( entries[j].isDirectory() && !isDotOrDotDot( entries[j] ) && shouldShow( entries[j], options ) ) {
				std::cout << "\n";
				listPath( std::filesystem::path( entries[j].path() ), options, fmt, true );
			}
			++j;
		}
	}

	return 0;
}

func main( const int argc, const char *[] argv ) -> int
{
	var Options options;
	options.showAll       = false;
	options.almostAll     = false;
	options.nameOnly      = false;
	options.humanReadable = false;
	options.longFormat    = false;
	options.recursive     = false;
	options.reverse       = false;
	options.sortMode      = SortMode::Name;
	var int i = 1;

	while( argc > i ) {
		const string arg = (string)argv[i];
		if( arg.length() > 1 && arg[0] == '-' ) {
			var usize j = 1;
			while( j < arg.length() ) {
				switch( arg[j] ) {
					case 'a': options.showAll       = true;
					case 'A': options.almostAll     = true;
					case 'h': options.humanReadable = true;
					case 'l': options.longFormat    = true;
					case 'n':
					case '1': options.nameOnly      = true;
					case 'R': options.recursive     = true;
					case 'r': options.reverse       = true;
					case 's': options.sortMode      = SortMode::Size;
					case 't': options.sortMode      = SortMode::Time;
					default:
						std::cerr << "ls: unknown option -- " << arg[j] << "\n";
						return 1;
				}
				++j;
			}
			++i;
		}
		else {
			break;
		}
	}

	var std::vector<std::filesystem::path> targets = std::vector<std::filesystem::path>();
	while( i < argc ) {
		targets.push_back( std::filesystem::path( (string)argv[i] ) );
		++i;
	}
	if( targets.size() == 0 )
		targets.push_back( std::filesystem::path( "." ) );

	var Formatter *! fmt;
	if( options.longFormat )
		fmt = new LongFormatter*!( options.humanReadable );
	else if( options.nameOnly )
		fmt = new NameOnlyFormatter*!;
	else
		fmt = new DetailedFormatter*!( options.humanReadable );

	var bool printHeader = targets.size() > 1;
	var int exitCode = 0;
	var usize t = 0;
	while( t < targets.size() ) {
		if( t > 0 )
			std::cout << "\n";
		if( printHeader )
			std::cout << targets[t].generic_string() << ":\n";
		if( listPath( targets[t], options, fmt, false ) != 0 )
			exitCode = 1;
		++t;
	}

	return exitCode;
}

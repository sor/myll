module ls;

import std_iostream, std_filesystem, std_vector, std_string, std_algorithm;

enum SortMode {
	Name,
	Size,
	Time,
}

class DirEntry
{
	field {
		std::filesystem::path               _path;
		u64                                 _size = 0;
		std::filesystem::file_time_type     _time;
		bool                                _isDirectory = false;
	}

[pub]:
	ctor( const std::filesystem::path & path )
	{
		_path = path;
		_isDirectory = std::filesystem::is_directory( _path );
		try {
			_time = std::filesystem::last_write_time( _path );
		}
		catch() {
			_time = std::filesystem::file_time_type::min();
		}
		if( !_isDirectory ) {
			try {
				_size = std::filesystem::file_size( _path );
			}
			catch() {
				_size = 0;
			}
		}
	}

	[pure]
	func name() -> string => (string)_path.filename().generic_string();

	[pure]
	func size() -> u64 => _size;

	[pure]
	func time() -> std::filesystem::file_time_type => _time;

	[pure]
	func isDirectory() -> bool => _isDirectory;
}

class Formatter
{
[pub]:
	[virtual]
	func format( const DirEntry & e ) -> string => "";
}

func humanSize( u64 bytes ) -> string
{
	if( bytes >= 1024 * 1024 * 1024 )
		return std::to_string( bytes / (1024 * 1024 * 1024) ) + "G";
	if( bytes >= 1024 * 1024 )
		return std::to_string( bytes / (1024 * 1024) ) + "M";
	if( bytes >= 1024 )
		return std::to_string( bytes / 1024 ) + "K";
	return std::to_string( bytes );
}

class DetailedFormatter : Formatter
{
	field bool _humanReadable = false;

[pub]:
	ctor( bool humanReadable )
	{
		_humanReadable = humanReadable;
	}

	[override]
	func format( const DirEntry & e ) -> string
	{
		var string s = (_humanReadable ? humanSize( e.size() ) : std::to_string( e.size() ))
			+ " " + e.name();
		if( e.isDirectory() )
			s += "/";
		return s + "\n";
	}
}

class NameOnlyFormatter : Formatter
{
[pub]:
	[override]
	func format( const DirEntry & e ) -> string
	{
		var string s = e.name();
		if( e.isDirectory() )
			s += "/";
		return s + "\n";
	}
}

func entryNameLess( const DirEntry & a, const DirEntry & b ) -> bool
{
	return a.name() < b.name();
}

func entrySizeLess( const DirEntry & a, const DirEntry & b ) -> bool
{
	if( a.size() != b.size() )
		return a.size() > b.size();
	return a.name() < b.name();
}

func entryTimeLess( const DirEntry & a, const DirEntry & b ) -> bool
{
	if( a.time() != b.time() )
		return a.time() > b.time();
	return a.name() < b.name();
}

func isHidden( const DirEntry & e ) -> bool
{
	return e.name().length() > 0 && e.name().compare( 0, 1, "." ) == 0;
}

func main( const int argc, const char *[] argv ) -> int
{
	var bool     showHidden    = false;
	var bool     nameOnly      = false;
	var bool     humanReadable = false;
	var SortMode sortMode      = SortMode::Name;
	var int      i = 1;

	while( argc > i ) {
		const string arg = (string)argv[i];
		if( arg.length() > 1 && arg[0] == '-' ) {
			switch( arg[1] ) {
				case 'a': showHidden    = true;
				case 'n': nameOnly      = true;
				case 'h': humanReadable = true;
				case 's': sortMode      = SortMode::Size;
				case 't': sortMode      = SortMode::Time;
				default:
					std::cerr << "ls: unknown option " << arg << "\n";
					return 1;
			}
			++i;
		}
		else {
			// args ended, all are now file/dir-names
			break;
		}
	}

	var std::filesystem::path target = std::filesystem::path( "." );
	if( argc > i )
		target = std::filesystem::path( (string)argv[i] );

	if( !std::filesystem::exists( target ) || !std::filesystem::is_directory( target ) ) {
		std::cerr << "ls: " << target.generic_string() << ": no such directory\n";
		return 1;
	}

	var std::vector<DirEntry> entries = std::vector<DirEntry>();

	var std::filesystem::directory_iterator it  = std::filesystem::directory_iterator( target );
	var std::filesystem::directory_iterator end = std::filesystem::directory_iterator();

	while( it != end ) {
		entries.push_back( DirEntry( (*it).path() ) );
		++it;
	}

	if( sortMode == SortMode::Name )
		std::sort( entries.begin(), entries.end(), entryNameLess );
	else if( sortMode == SortMode::Size )
		std::sort( entries.begin(), entries.end(), entrySizeLess );
	else
		std::sort( entries.begin(), entries.end(), entryTimeLess );

	var Formatter *! fmt;
	if( nameOnly )
		fmt = new NameOnlyFormatter*!;
	else
		fmt = new DetailedFormatter*!( humanReadable );

	var usize k = 0;
	while( k < entries.size() ) {
		if( showHidden || !isHidden( entries[k] ) )
			std::cout << fmt->format( entries[k] );
		++k;
	}

	return 0;
}

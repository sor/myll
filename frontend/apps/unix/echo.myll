module echo;

import std_iostream;

func main( const int argc, const char *[] argv ) -> int
{
	const bool no_newline = argc > 1 && (string)argv[1] == "-n";
	var int i = no_newline ? 2 : 1;

	var bool first = true;
	while( i < argc ) {
		if( !first )
			std::cout << " ";
		std::cout << argv[i];
		first = false;
		++i;
	}

	if( !no_newline )
		std::cout << "\n";

	return 0;
}

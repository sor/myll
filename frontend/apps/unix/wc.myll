module wc;

import std_iostream, std_fstream, std_string;

func wcStream( std::istream & in ) -> void
{
	var string line;
	var u64 bytes = 0;
	var u64 lines = 0;
	var u64 words = 0;
	var bool in_word = false;

	while( std::getline(in, line) ) {
		++lines;
		bytes += line.length() + 1;

		var usize pos = 0;
		while( pos < line.length() ) {
			const char c = line[pos];
			const bool isSpace = c == ' ' || c == '\t' || c == '\r' || c == '\f' || c == '\v';
			if( !isSpace && !in_word )
				++words;
			in_word = !isSpace;
			++pos;
		}
	}

	std::cout << lines << " " << words << " " << bytes << "\n";
}

func main( const int argc, const char *[] argv ) -> int
{
	if( argc <= 1 ) {
		wcStream( std::cin );
		return 0;
	}

	var int i = 1;
	while( i < argc ) {
		var std::ifstream file = std::ifstream( argv[i] );
		if( !file ) {
			std::cerr << "wc: " << argv[i] << ": cannot open file\n";
			return 1;
		}
		wcStream( file );
		++i;
	}

	return 0;
}

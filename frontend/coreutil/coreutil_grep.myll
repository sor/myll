module coreutil_grep;

import std_iostream, std_fstream, std_string, std_vector, c_ctype, cxxopts;
import myll_string;

namespace JanSordid::Coreutil:

struct GrepOptions
{
	field bool ignore_case;
	field bool invert;
	field bool line_number;
	field bool count;
	field bool list_files;
	field bool whole_line;
	field bool no_filename;
	field bool with_filename;
	field Myll::String pattern;
};

func grepUsage() -> int
{
	std::cerr << "usage: grep [options] pattern [file...]\n"
	          << "options: -e pattern  -i  -v  -n  -c  -l  -x  -H  -h\n";
	return 1;
}

func grepCharEquals( const char a, const char b, const bool ignore_case ) -> bool
{
	if( !ignore_case )
		return a == b;
	return std::tolower( a ) == std::tolower( b );
}

func grepStringEquals( const Myll::StringView a, const Myll::StringView b, const bool ignore_case ) -> bool
{
	if( a.len() != b.len() )
		return false;

	var usize i = 0;
	while( i < a.len() ) {
		if( !grepCharEquals( a[i], b[i], ignore_case ) )
			return false;
		++i;
	}
	return true;
}

func grepContains( const Myll::StringView haystack, const Myll::StringView needle, const bool ignore_case ) -> bool
{
	if( needle.len() == 0 )
		return true;
	if( needle.len() > haystack.len() )
		return false;

	const usize last = haystack.len() - needle.len();
	var usize i = 0;
	while( i <= last ) {
		var usize j = 0;
		while( j < needle.len() ) {
			if( !grepCharEquals( haystack[i + j], needle[j], ignore_case ) )
				break;
			++j;
		}
		if( j == needle.len() )
			return true;
		++i;
	}
	return false;
}

func grepMatches( const Myll::StringView line, const Myll::StringView pattern, const bool whole_line,
	const bool ignore_case ) -> bool
{
	if( whole_line )
		return grepStringEquals( line, pattern, ignore_case );
	return grepContains( line, pattern, ignore_case );
}

func grepStream( const string & file_name, std::istream & in, const GrepOptions & opts,
	const bool print_name ) -> int
{
	var string line;
	var int line_no = 0;
	var int match_count = 0;

	const Myll::StringView pattern = opts.pattern.view();

	while( std::getline( in, line ) ) {
		++line_no;
		const Myll::StringView text( line.c_str(), line.length() );
		var bool matched = grepMatches( text, pattern, opts.whole_line, opts.ignore_case );
		if( opts.invert )
			matched = !matched;

		if( !matched )
			continue;

		++match_count;

		if( opts.list_files ) {
			std::cout << file_name << "\n";
			return 0;
		}

		if( opts.count )
			continue;

		if( print_name )
			std::cout << file_name << ":";
		if( opts.line_number )
			std::cout << line_no << ":";
		std::cout << line << "\n";
	}

	if( opts.count ) {
		if( print_name )
			std::cout << file_name << ":";
		std::cout << match_count << "\n";
	}

	return 0;
}

func grep( int argc, const char *[] argv ) -> int
{
	var cxxopts::Options cxx = cxxopts::Options( "grep", "search for pattern in files" );
	cxx.add_options()
		( "i,ignore-case", "Ignore case", cxxopts::value<bool>()->default_value( "false" ) )
		( "v,invert-match", "Invert match", cxxopts::value<bool>()->default_value( "false" ) )
		( "n,line-number", "Show line numbers", cxxopts::value<bool>()->default_value( "false" ) )
		( "c,count", "Count matches", cxxopts::value<bool>()->default_value( "false" ) )
		( "l,files-with-matches", "List files with matches",
		  cxxopts::value<bool>()->default_value( "false" ) )
		( "x,line-regexp", "Match whole lines", cxxopts::value<bool>()->default_value( "false" ) )
		( "H,with-filename", "Print filename", cxxopts::value<bool>()->default_value( "false" ) )
		( "h,no-filename", "Suppress filename", cxxopts::value<bool>()->default_value( "false" ) )
		( "e,regexp", "Pattern", cxxopts::value<string>() );

	var cxxopts::ParseResult result = cxx.parse( argc, argv );

	var GrepOptions opts = GrepOptions();
	opts.ignore_case = result["ignore-case"].as<bool>();
	opts.invert = result["invert-match"].as<bool>();
	opts.line_number = result["line-number"].as<bool>();
	opts.count = result["count"].as<bool>();
	opts.list_files = result["files-with-matches"].as<bool>();
	opts.whole_line = result["line-regexp"].as<bool>();
	opts.with_filename = result["with-filename"].as<bool>();
	opts.no_filename = result["no-filename"].as<bool>();

	if( result.count( "regexp" ) != 0 ) {
		opts.pattern = Myll::String( result["regexp"].as<string>().c_str() );
	}

	const std::vector<string> positional = result.unmatched();
	var usize pos = 0;

	if( opts.pattern.isEmpty() ) {
		if( positional.size() == 0 )
			return grepUsage();
		var string first = positional[pos];
		opts.pattern = Myll::String( first.c_str() );
		++pos;
	}

	var bool print_name = false;
	if( !opts.no_filename ) {
		if( opts.with_filename )
			print_name = true;
		else if( positional.size() - pos > 1 )
			print_name = true;
	}

	if( pos >= positional.size() ) {
		return grepStream( "-", std::cin, opts, print_name );
	}

	while( pos < positional.size() ) {
		const string path = positional[pos];
		if( path == "-" ) {
			grepStream( "-", std::cin, opts, print_name );
		}
		else {
			var std::ifstream file = std::ifstream( path );
			if( !file ) {
				std::cerr << "grep: " << path << ": cannot open file\n";
				return 1;
			}
			grepStream( path, file, opts, print_name );
		}
		++pos;
	}

	return 0;
}

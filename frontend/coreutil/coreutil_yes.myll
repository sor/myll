module coreutil_yes;

import std_iostream, std_vector, cxxopts;

namespace JanSordid::Coreutil:

func yes( int argc, const char *[] argv ) -> int
{
	var cxxopts::Options options = cxxopts::Options( "yes", "print a string repeatedly" );
	var cxxopts::ParseResult result = options.parse( argc, argv );
	const std::vector<string> args = result.unmatched();

	const string s = args.size() > 0 ? args[0] : "y";

	while( true )
		std::cout << s << "\n";

	return 0;
}

module std_string;
import <string>;

namespace std {
	// std::string backing class for Myll's `string` keyword.
	// Declared here only for Myll-side resolution; the real definition
	// comes from the C++ standard library <string> header.
	class string {
	[pub]:
		ctor();
		ctor( const char * str );

		func length() -> usize;
		func substr( usize pos, usize len ) -> std::string;
		func compare( usize pos, usize len, const std::string & str ) -> int;

		operator []( usize index ) -> char &;
		operator +=( const std::string & other ) -> std::string &;
	};

	operator +( const std::string & a, const std::string & b ) -> std::string;
	operator <( const std::string & a, const std::string & b ) -> bool;
	operator ==( const std::string & a, const std::string & b ) -> bool;
	operator !=( const std::string & a, const std::string & b ) -> bool;

	// Numeric conversions from <string>.
	func to_string( int value ) -> std::string;
	func to_string( i64 value ) -> std::string;
	func to_string( u64 value ) -> std::string;
	func to_string( f32 value ) -> std::string;
	func to_string( f64 value ) -> std::string;

	func stoi( const std::string & str ) -> int;
}

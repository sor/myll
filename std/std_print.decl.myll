module std_print;
import <print>;
import std_string;
import c_stdio;

namespace std {
	func print( const std::string & fmt ) -> void;
	func print<T>( const std::string & fmt, const T & arg ) -> void;
	func print<T>( FILE * stream, const std::string & fmt, const T & arg ) -> void;

	func println( const std::string & fmt ) -> void;
	func println<T>( const std::string & fmt, const T & arg ) -> void;
	func println<T>( FILE * stream, const std::string & fmt, const T & arg ) -> void;

	// Variadic forms: the trailing pack absorbs any number of arguments; the
	// raw emitted call resolves against the real std::print/std::println
	// overload set.
	func print<T...>( const std::string & fmt, T args ) -> void;
	func println<T...>( const std::string & fmt, T args ) -> void;
}

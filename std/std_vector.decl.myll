module std_vector;
import <vector>;

namespace std {
	// std::vector backing declaration for Myll resolution.
	// The real definition comes from the C++ standard library <vector> header.
	class vector<T> {
	[pub]:
		[ct,noexcept] ctor();
		[ct] ctor( usize count );

		func push_back( const T & value ) -> void;
		func pop_back() -> void;

		[pure,ct,nodiscard,noexcept] func size() -> usize;
		[pure,ct,nodiscard,noexcept] func empty() -> bool;

		[pure,ct,nodiscard,noexcept] func begin() -> T*;
		[pure,ct,nodiscard,noexcept] func end() -> T*;

		[pure,ct,nodiscard,noexcept] func data() -> T[*];

		[pure,ct,nodiscard,noexcept] operator []( usize index ) -> const T &;
		                  [noexcept] operator []( usize index ) -> T &;
	};
}

module std_iostream;
import <iostream>;

namespace std {
	class streambuf;

	class ostream {
	[pub]:
		func flush() -> void;

		operator <<( const std::string & value ) -> ostream &;
		operator <<( const char * value ) -> ostream &;
		operator <<( char value ) -> ostream &;
		operator <<( int value ) -> ostream &;
		operator <<( u64 value ) -> ostream &;
		operator <<( bool value ) -> ostream &;
		operator <<( std::streambuf * sb ) -> ostream &;

		[pure,nodiscard] operator !() -> bool;
	};

	class istream {
	[pub]:
		[pure,nodiscard] func rdbuf() -> std::streambuf *;

		operator >>( std::string & value ) -> istream &;
		operator >>( int & value ) -> istream &;
		operator >>( u64 & value ) -> istream &;

		[pure,nodiscard] operator !() -> bool;
	};

	class ostringstream;

	var ostream cout;
	var ostream cerr;
	var istream cin;

	func getline( istream & in, std::string & line ) -> bool;
}

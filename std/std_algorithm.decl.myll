module std_algorithm;
import <algorithm>;

namespace std {
	// Sorting/reversal helpers. The real definitions are in <algorithm>.
	[ct] func sort<Iter>( Iter first, Iter last ) -> void;
	[ct] func sort<Iter, Compare>( Iter first, Iter last, Compare comp ) -> void;
	[ct] func reverse<Iter>( Iter first, Iter last ) -> void;
}

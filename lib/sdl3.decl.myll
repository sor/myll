module sdl3;
import <SDL3/SDL.h>;

[extern] struct SDL_Window {}
[extern] struct SDL_Renderer {}
[extern] struct SDL_FRect {
[pub]:
	var f32 x;
	var f32 y;
	var f32 w;
	var f32 h;
}
[extern] struct SDL_Rect {
[pub]:
	var int x;
	var int y;
	var int w;
	var int h;
}
[extern] struct SDL_Event {
[pub]:
	var u32 type;
}

const u32 SDL_INIT_VIDEO;
const u64 SDL_WINDOW_RESIZABLE;
const u32 SDL_EVENT_QUIT;

const int SDL_SCANCODE_UP;
const int SDL_SCANCODE_DOWN;
const int SDL_SCANCODE_LEFT;
const int SDL_SCANCODE_RIGHT;
const int SDL_SCANCODE_W;
const int SDL_SCANCODE_S;

[noexcept] func SDL_Init( u32 flags ) -> bool;
[noexcept] func SDL_CreateWindow( const char * title, int w, int h, u64 flags ) -> SDL_Window *;
[noexcept] func SDL_CreateRenderer( SDL_Window * window, const char * name ) -> SDL_Renderer *;
[noexcept] func SDL_PollEvent( SDL_Event * event ) -> bool;
[noexcept] func SDL_GetKeyboardState( int * numkeys ) -> const bool *;
[noexcept] func SDL_SetRenderDrawColor( SDL_Renderer * r, u8 red, u8 green, u8 blue, u8 alpha ) -> bool;
[noexcept] func SDL_RenderClear( SDL_Renderer * r ) -> bool;
[noexcept] func SDL_RenderFillRect( SDL_Renderer * r, SDL_FRect * rect ) -> bool;
[noexcept] func SDL_RenderPresent( SDL_Renderer * r ) -> void;
[noexcept] func SDL_Delay( u32 ms ) -> void;
[noexcept] func SDL_DestroyRenderer( SDL_Renderer * r ) -> void;
[noexcept] func SDL_DestroyWindow( SDL_Window * window ) -> void;
[noexcept] func SDL_Quit() -> void;

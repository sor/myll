module main;

class Box<T>
{
	field T _value;

[pub]:
	method assign( const T & value )
	{
		_value = value;
	}

	method assign( T && value )
	{
		_value = (move)value;
	}

	method retrieve() -> T
	{
		return _value;
	}

	method store<U>( U x, T y )
	{
		_value = y;
	}
}

class Base<T>
{
[pub]:
	method baseAssign( const T & value ) { }
	method baseAssign( T && value ) { }
}

class Derived<T> : Base<T>
{
}

alias IntBox = Box<int>;
alias IntBox2 = IntBox;

func main() -> int
{
	var Box<int> b;

	var int x = 5;
	b.assign( x );
	if( b.retrieve() != 5 )
		return 1;

	b.assign( 10 );
	if( b.retrieve() != 10 )
		return 2;

	b.store( 1.5, 7 );
	if( b.retrieve() != 7 )
		return 3;

	var Derived<int> d;
	d.baseAssign( x );
	d.baseAssign( 20 );

	var IntBox ab;
	ab.assign( 30 );
	if( ab.retrieve() != 30 )
		return 7;

	var IntBox2 ab2;
	ab2.assign( 40 );
	if( ab2.retrieve() != 40 )
		return 8;

	var IntBox * ap = new IntBox;
	ap->assign( 50 );
	if( ap->retrieve() != 50 )
		return 9;

	return 0;
}

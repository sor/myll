module main;

import nums, nums_spec;

func main() -> int {
	// full specialization from nums_spec
	if( pi<int> != 3 )
		return 1;
	// primary instantiation from nums
	if( pi<f32> < 3.0 || pi<f32> > 3.3 )
		return 2;
	// partial specialization from nums_spec
	if( q<i64, int> != 70 )
		return 3;
	// primary instantiation from nums
	if( q<int, i64> != 7 )
		return 4;
	// runtime specialization from nums_spec (inline variable)
	if( rt<i32> != 5 )
		return 5;
	return 0;
}
// Cross-module specializations: the primary lives in nums; this module
// imports it and adds specializations. The generated header includes
// nums.hpp, so the primary precedes every specialization.
module nums_spec;

import nums;

[spec] const T pi<T=int> = 3;
[spec] const T q<T, U=int> = (T)70;
[spec] var T rt<T=i32> = 5;
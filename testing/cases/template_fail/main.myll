func max<T>( T a, T b ) -> T => a > b ? a : b;

class Box<T> {
[pub]:
	field T value;
}

func identity<T>( T value ) -> T => value;

const T answer<T> = (T)42;

var T blah<T> = T; // FAIL: Type template parameter 'T' cannot be used as a value

func add<int N>( int x ) -> int => x + N;

func typeParamAsValue<T>() -> int {
	return T; // FAIL: Type template parameter 'T' cannot be used as a value
}

func test_arg_count_mismatch() -> void {
	max<int, float>( 1, 2 ); // FAIL: Template argument count mismatch for 'max'
	var Box<int, float> b = Box<int, float>(); // FAIL: Template argument count mismatch for type 'Box'
	var int a = answer<int, int>; // FAIL: Template argument count mismatch for variable 'answer'
}

func test_template_conversion_mismatch() -> int {
	identity<int>( "hello" ); // FAIL: No matching overload for 'identity'
	return 0;
}

func test_template_kind_mismatch() -> int {
	var Box<42> a; // FAIL: Template argument kind mismatch for type 'Box'
	var int b = identity<42>( 1 ); // FAIL: Template argument kind mismatch for 'identity'
	var int c = answer<42>; // FAIL: Template argument kind mismatch for variable 'answer'
	var int d = add<int>( 10 ); // FAIL: Template argument kind mismatch for 'add'
	typeParamAsValue<int>();
	return 0;
}

func main() -> int {
	return 0;
}

// variable template specialization validation
const T spec_pi<T> = (T)3;
const T spec_pi<X=int> = 4; // FAIL: Unknown template parameter 'X' in specialization of 'spec_pi'

const T spec_r<T, U, V> = (T)1;
const T spec_r<V=int, U=f32> = (T)2; // FAIL: Bindings of 'spec_r' must follow the primary's parameter order

const T spec_noPrimary<T=int> = 3; // FAIL: No matching variable template 'spec_noPrimary' in this module

const T spec_late<T=int> = 4; // FAIL: Specialization of 'spec_late' must follow its primary template
const T spec_late<T> = (T)1;

const T spec_dup<T> = (T)1;
const T spec_dup<T=int> = 4;
const T spec_dup<T=int> = 5; // FAIL: Duplicate specialization of 'spec_dup' for T=int

const T spec_mm<T> = (T)1;
const f32 spec_mm<T=int> = 2.0; // FAIL: Specialization of 'spec_mm' declares type 'const float' but the primary's substituted type is 'const int'

// full-form specialization validation: skip form and wrong position
const T spec3<T, U, V> = (T)1;
const T spec3<T, V=int> = (T)2; // FAIL: Specialization 'spec3' names 2 of 3 parameters
const T spec4<T, U> = (T)1;
const T spec4<U, T=int> = (T)2; // FAIL: Specialization 'spec4' names 'U' at parameter 'T''s position
const T spec5<T, U> = (T)1;
const T spec5<T, U=int> = (T)2;
const T spec5<U=int> = (T)3; // FAIL: Duplicate specialization of 'spec5' for U=int

// class/struct/union specialization validation
class SBox<T> { field int v; }
class SBox<X=int> { field int v; } // FAIL: Unknown template parameter 'X' in specialization of 'SBox'

class SOrder<T, U> { field int v; }
class SOrder<U=int, T=f32> { field int v; } // FAIL: Bindings of 'SOrder' must follow the primary's parameter order

class SSkip<T, U, V> { field int v; }
class SSkip<T, V=int> { field int v; } // FAIL: Specialization 'SSkip' names 2 of 3 parameters

class SDup<T> { field int v; }
class SDup<T=int> { field int v; }
class SDup<T=int> { field int v; } // FAIL: Duplicate specialization of 'SDup' for T=int

class SLate<T=int> { field int v; } // FAIL: Specialization of 'SLate' must follow its primary template
class SLate<T> { field int v; }

class SNoTpl<T=int> { field int v; } // FAIL: No matching template 'SNoTpl' in this module

// function template specialization validation (full-only, signature repeat)
func fval<T, U>( T a, U b ) -> T => a;
func fval<T=int>( int a, int b ) -> int => a; // FAIL: Function templates allow only full specializations

func fno<T>( T a ) -> T => a;
func fno<X=int>( int a ) -> int => a; // FAIL: Unknown template parameter 'X' in specialization of 'fno'

func forder<T, U>( T a, U b ) -> T => a;
func forder<U=int, T=f32>( f32 a, int b ) -> f32 => a; // FAIL: Bindings of 'forder' must follow the primary's parameter order

func fdup<T>( T a ) -> T => a;
func fdup<T=int>( int a ) -> int => a;
func fdup<T=int>( int a ) -> int => a; // FAIL: Duplicate specialization of 'fdup' for T=int

func flate<T=int>( int a ) -> int => a; // FAIL: Specialization of 'flate' must follow its primary template
func flate<T>( T a ) -> T => a;

func fnoprimary<T=int>( int a ) -> int => a; // FAIL: No matching function template 'fnoprimary'

func fparam<T>( T a ) -> T => a;
func fparam<T=int>( int a, int b ) -> int => a; // FAIL: Specialization of 'fparam' must repeat the primary's substituted parameter and return types

func fret<T>( T a ) -> T => a;
func fret<T=int>( int a ) -> f32 => 1.5; // FAIL: Specialization of 'fret' must repeat the primary's substituted parameter and return types

func fauto<T>( T a ) => a;
func fauto<T=int>( int a ) => a; // FAIL: Specialization of 'fauto' must repeat the primary's return type

// method specialization validation (class params first, then method params)
class MHost<T> {
[pub]:
	func open<U>( U a ) -> U => a;
	func open<U=int>( U a ) -> U => a; // FAIL: Specialization of 'open' must bind all class template parameters

	func named<X=int>( int a ) -> int => a; // FAIL: No matching method template 'named'

	func sym<U>( U a ) -> U => a;
	func sym<T=U>( int a ) -> int => a; // FAIL: Specialization of 'sym' must bind 'T' to a concrete type

	func dup<U>( U a ) -> U => a;
	func dup<T=int, U=f32>( f32 a ) -> f32 => a;
	func dup<T=int, U=f32>( f32 a ) -> f32 => a; // FAIL: Duplicate specialization of 'dup' for T=int,U=float

	func shadow<T>( T a ) -> T => a;
	func shadow<T=int>( int a ) -> int => a; // FAIL: Method 'shadow' has a template parameter shadowing
}

class MSpec<T=int> {
[pub]:
	func inner( int a ) -> int => a;
	func inner<T=f32>( f32 a ) -> f32 => a; // FAIL: Specialization of 'inner' sits inside the specialization
}

class MPlain {
[pub]:
	func partial<A, B>( A a, B b ) -> A => a;
	func partial<A=int, B>( int a, int b ) -> int => a; // FAIL: Function templates allow only full specializations
}

// constructor specialization validation
class CPlain {
[pub]:
	ctor( int v ) { }
	ctor<T=int>( int v ) { } // FAIL: Constructor specializations need a class template
}

class CCover<T> {
[pub]:
	ctor( T v ) { }
	ctor<X=int>( int v ) { } // FAIL: No matching constructor template in 'CCover'
}

class CSym<T> {
[pub]:
	ctor<U>( U u, T t ) { }
	ctor<T=U>( int u, int t ) { } // FAIL: Specialization of 'CSym' must bind 'T' to a concrete type
}

class CSig<T> {
[pub]:
	ctor( T v ) { }
	ctor<T=int>( int v, int b ) { } // FAIL: Specialization of the constructor of 'CSig' must repeat the primary's substituted parameters
}

// non-type binding kind validation
class BadKind<T> {
[pub]:
	ctor() {}
	func f() -> int => 0;
	func f<T=5>() -> int => 1; // FAIL: Specialization of 'f' must bind the type parameter 'T' to a type
	func g<int N>() -> int => N;
	func g<N=int>() -> int => 1; // FAIL: Specialization of 'g' must bind the non-type parameter 'N' to a value
}

// alias templates cannot be specialized (C++ has no spelling for it)
alias BadSpec<T> = BadSpec<T>;
alias BadSpec<T=int> = BadSpec<int>; // FAIL: Alias templates cannot be specialized

// member variable specialization validation (class params first, at least one own param bound)
class MVBox<T> {
[pub]:
	[static] field const T y<U> = (U)0;
	[static] field const T y<U=int> = 1; // FAIL: Specialization of 'y' must bind all class template parameters
}

class MVOpen<T> {
[pub]:
	[static] field const T z<U> = (U)0;
	[static] field const T z<T=int> = 1; // FAIL: Specialization of 'z' must bind at least one of 'MVOpen's own template parameters
}

class MVSpec<T> {
[pub]:
	[static] field const T w<U> = (U)0;
}

class MVSpec<T=int> {
[pub]:
	[static] field const T w<U=int> = 1; // FAIL: Specialization of 'w' sits inside the specialization
}

class MVStatic<T> {
[pub]:
	field const T n<U> = (U)0; // FAIL: Member variable templates must be [static]
}

class MVStaticSpec<T> {
[pub]:
	[static] field const T m<U> = (U)0;
	[static] field const T m<T=int, U=int> = 1;
	field const T m2<T=int, U=int> = 2; // FAIL: Member variable templates must be [static]
}

class MVDeep {
[pub]:
	class Mid {
	[pub]:
		class Deep<V> { field V v; }
		class Deep<V=int> { field int v; } // FAIL: Specializations of nested classes inside another nested class are not supported yet
	}
}

import std_vector, std_array;

func max<T>( T a, T b ) -> T => a > b ? a : b;

class Box<T> {
[pub]:
	field T value;
}

func identity<T>( T value ) -> T => value;

const T answer<T> = (T)42;

var T blah<T> = T; // FAIL: Type template parameter 'T' cannot be used as a value

func add<int N>( int x ) -> int => x + N;

func typeParamAsValue<T>() -> int {
	return T; // FAIL: Type template parameter 'T' cannot be used as a value
}

func test_arg_count_mismatch() -> void {
	max<int, float>( 1, 2 ); // FAIL: Template argument count mismatch for 'max'
	var Box<int, float> b = Box<int, float>(); // FAIL: Template argument count mismatch for type 'Box'
	var int a = answer<int, int>; // FAIL: Template argument count mismatch for variable 'answer'
}

func test_template_conversion_mismatch() -> int {
	identity<int>( "hello" ); // FAIL: No matching overload for 'identity'
	return 0;
}

func test_template_kind_mismatch() -> int {
	var Box<42> a; // FAIL: Template argument kind mismatch for type 'Box'
	var int b = identity<42>( 1 ); // FAIL: Template argument kind mismatch for 'identity'
	var int c = answer<42>; // FAIL: Template argument kind mismatch for variable 'answer'
	var int d = add<int>( 10 ); // FAIL: Template argument kind mismatch for 'add'
	typeParamAsValue<int>();
	return 0;
}

func main() -> int {
	return 0;
}

// variable template specialization validation
const T spec_pi<T> = (T)3;
[spec] const T spec_pi<X=int> = 4; // FAIL: Unknown template parameter 'X' in specialization of 'spec_pi'

const T spec_r<T, U, V> = (T)1;
[spec] const T spec_r<V=int, U=f32> = (T)2; // FAIL: Bindings of 'spec_r' must follow the primary's parameter order

const T spec_noPrimary<T=int> = 3; // legal now: a new defaulted primary

[spec] const T spec_late<T=int> = 4; // FAIL: Specialization of 'spec_late' must follow its primary template
const T spec_late<T> = (T)1;

const T spec_dup<T> = (T)1;
[spec] const T spec_dup<T=int> = 4;
[spec] const T spec_dup<T=int> = 5; // FAIL: Duplicate specialization of 'spec_dup' for T=int

const T spec_mm<T> = (T)1;
[spec] const f32 spec_mm<T=int> = 2.0; // FAIL: Specialization of 'spec_mm' declares type 'const float' but the primary's substituted type is 'const int'

// full-form specialization validation: skip form and wrong position
const T spec3<T, U, V> = (T)1;
[spec] const T spec3<T, V=int> = (T)2; // FAIL: Specialization 'spec3' names 2 of 3 parameters
const T spec4<T, U> = (T)1;
[spec] const T spec4<U, T=int> = (T)2; // FAIL: Specialization 'spec4' names 'U' at parameter 'T''s position
const T spec5<T, U> = (T)1;
[spec] const T spec5<T, U=int> = (T)2;
[spec] const T spec5<U=int> = (T)3; // FAIL: Duplicate specialization of 'spec5' for U=int

// class/struct/union specialization validation
class SBox<T> { field int v; }
[spec=all] class SBox<X=int> { field int v; } // FAIL: Unknown template parameter 'X' in specialization of 'SBox'

class SOrder<T, U> { field int v; }
[spec=all] class SOrder<U=int, T=f32> { field int v; } // FAIL: Bindings of 'SOrder' must follow the primary's parameter order

class SSkip<T, U, V> { field int v; }
[spec=all] class SSkip<T, V=int> { field int v; } // FAIL: Specialization 'SSkip' names 2 of 3 parameters

// Pattern bindings with unsupported shapes
class PSym<T> { field int v; }
[spec=all] class PSym<T=T> { field int v; } // FAIL: bare parameter binding matches every instantiation

class PNest<T> { field int v; }
[spec=all] class PNest<T=Box<T>> { field int v; } // FAIL: nested patterns are not supported yet

class PArr<T> { field int v; }
[spec=all] class PArr<T=T[3]> { field int v; } // FAIL: array patterns are not supported yet

class PQual<T> { field int v; }
[spec=all] class PQual<T=const T*> { field int v; } // FAIL: qualified patterns are not supported yet

class PBoth<T, U> { field int v; }
[spec=all] class PBoth<T=int, U=T*> { field int v; } // FAIL: parameter 'T' cannot be concretely bound and pattern-deduced at once

// Same-tier matches with no partial-order winner stay ambiguous
class PTie<T, U> { field int v; }
[spec=all] class PTie<T=int, U> { field int v; }
[spec=all] class PTie<T, U=int*> { field int v; }
func test_pattern_tie_ambiguous() -> void {
	var PTie<int, int*> v; // FAIL: Ambiguous specialization match for 'PTie'
}

// [spec=...] attribute validation on class/struct/union specializations
class SSkip2<T, U> { field int v; }
class SSkip2<T=int> { field int v; } // FAIL: A class template 'SSkip2' is already declared

// Defaults must be trailing and defaulted parameters cannot be bound twice
class DfltFail<T=int, U> { field int v; } // FAIL: Parameter 'U' of 'DfltFail' needs a default
class NonTypeFail<int N=5> { field int v; } // legal non-type default: no error
[spec=some] class SSkip3<T=int> { field int v; } // FAIL: No matching template 'SSkip3'
[spec=partial] class SSkip4<T=int> { field int v; } // FAIL: must name its kind: [spec=all]
[spec] class SSkip5<T=int> { field int v; } // FAIL: must name its kind: [spec=all]
[spec=all] class SPlain { field int v; } // FAIL: The [spec=...] values of 'SPlain' apply only to specializations
class SSkip6<T> { field int v; }
[spec=primary] class SSkip6<T=int> { field int v; } // FAIL: A class template 'SSkip6' is already declared
class SSkip7<T, U> { field int v; }
[spec(all, full)] class SSkip7<T, U=int> { field int v; } // FAIL: declares [spec=(all, full)] but the bindings are partial
class SSkip8<T, U> { field int v; }
[spec(all, partial)] class SSkip8<T=int, U=int> { field int v; } // FAIL: declares [spec=(all, partial)] but every parameter is concretely bound
[spec(all, some)] class SSkip9<T=int> { field int v; } // FAIL: names both

// [spec=...] attribute validation on functions and variables
[spec=all] func fBad<T>( T a ) -> T => a; // FAIL: apply only to specializations
func fBad2<T>( T a ) -> T => a;
[spec=partial] func fBad2<T=int>( int a ) -> int => a; // FAIL: Function specializations are always full
func fBad3<T>( T a ) -> T => a;
[spec=primary] func fBad3<T=int>( int a ) -> int => a; // FAIL: A function template 'fBad3' is already declared
const T vSpec<T> = (T)0;
[spec=all] const T vSpec<T=int> = 5; // FAIL: the all/some kinds apply to class/struct/union specializations
[spec=banana] func fBanana<T>( T a ) -> T => a; // FAIL: Unknown [spec=banana] on 'fBanana'

// [spec=some] block validation
class SB<T, U> { [pub]: field T v; func F() -> T => v; }

[spec=some] class SB<T, U=int> { func F() -> int => 0; } // FAIL: Member specialization head of 'SB' must bind all class template parameters of 'SB'

[spec=some] class SB<T=f32, U=f32> { func Missing() -> int => 0; } // FAIL: Class 'SB' has no method 'Missing'

class SB2<T> { [pub]: field T v; func F() -> T => v; }

[spec=some] class SB2<T=int> { func F<T=f32>() -> int => 0; } // FAIL: Member specialization of 'F' must not bind class parameters

class SB3<T> { [pub]: field T v; }

[spec=all] class SB3<T=f32> { [pub]: field f32 v; }

[spec=some] class SB3<T=f32> { [pub]: func F() -> f32 => v; } // FAIL: Member specialization block of 'SB3' conflicts with the full specialization

class SB4<T> { [pub]: field T v; func F() -> T => v; }

[spec=some] class SB4<T=int> {
	func F() -> int => 1;
	func F() -> int => 2; // FAIL: Duplicate member specialization of 'F' in the block
}

class SDup<T> { field int v; }
[spec=all] class SDup<T=int> { field int v; }
[spec=all] class SDup<T=int> { field int v; } // FAIL: Duplicate specialization of 'SDup' for T=int

[spec=all] class SLate<T=int> { field int v; } // FAIL: Specialization of 'SLate' must follow its primary template
class SLate<T> { field int v; }

[spec=all] class SNoTpl<T=int> { field int v; } // FAIL: No matching template 'SNoTpl' in this module

// function template specialization validation (full-only, signature repeat)
func fval<T, U>( T a, U b ) -> T => a;
[spec] func fval<T=int>( int a, int b ) -> int => a; // FAIL: Function templates allow only full specializations

func fno<T>( T a ) -> T => a;
[spec] func fno<X=int>( int a ) -> int => a; // FAIL: Unknown template parameter 'X' in specialization of 'fno'

func forder<T, U>( T a, U b ) -> T => a;
[spec] func forder<U=int, T=f32>( f32 a, int b ) -> f32 => a; // FAIL: Bindings of 'forder' must follow the primary's parameter order

func fdup<T>( T a ) -> T => a;
[spec] func fdup<T=int>( int a ) -> int => a;
[spec] func fdup<T=int>( int a ) -> int => a; // FAIL: Duplicate specialization of 'fdup' for T=int

[spec] func flate<T=int>( int a ) -> int => a; // FAIL: Specialization of 'flate' must follow its primary template
func flate<T>( T a ) -> T => a;

[spec] func fnoprimary<T=int>( int a ) -> int => a; // FAIL: No matching function template 'fnoprimary'

func fparam<T>( T a ) -> T => a;
[spec] func fparam<T=int>( int a, int b ) -> int => a; // FAIL: Specialization of 'fparam' must repeat the primary's substituted parameter and return types

func fret<T>( T a ) -> T => a;
[spec] func fret<T=int>( int a ) -> f32 => 1.5; // FAIL: Specialization of 'fret' must repeat the primary's substituted parameter and return types

func fauto<T>( T a ) => a;
[spec] func fauto<T=int>( int a ) => a; // FAIL: Specialization of 'fauto' must repeat the primary's return type

// method specialization validation (class params first, then method params)
class MHost<T> {
[pub]:
	func open<U>( U a ) -> U => a;
	[spec] func open<U=int>( U a ) -> U => a; // FAIL: Specialization of 'open' must bind all class template parameters

	[spec] func named<X=int>( int a ) -> int => a; // FAIL: No matching method template 'named'

	func sym<U>( U a ) -> U => a;
	[spec] func sym<T=U>( int a ) -> int => a; // FAIL: Specialization of 'sym' must bind 'T' to a concrete type

	func dup<U>( U a ) -> U => a;
	[spec] func dup<T=int, U=f32>( f32 a ) -> f32 => a;
	[spec] func dup<T=int, U=f32>( f32 a ) -> f32 => a; // FAIL: Duplicate specialization of 'dup' for T=int,U=float

	func shadow<T>( T a ) -> T => a;
	[spec] func shadow<T=int>( int a ) -> int => a; // FAIL: Method 'shadow' has a template parameter shadowing
}

[spec=all] class MSpec<T=int> {
[pub]:
	func inner( int a ) -> int => a;
	[spec] func inner<T=f32>( f32 a ) -> f32 => a; // FAIL: Specialization of 'inner' sits inside the specialization
}

class MPlain {
[pub]:
	func partial<A, B>( A a, B b ) -> A => a;
	[spec] func partial<A=int, B>( int a, int b ) -> int => a; // FAIL: Function templates allow only full specializations
}

// constructor specialization validation
class CPlain {
[pub]:
	ctor( int v ) { }
	[spec] ctor<T=int>( int v ) { } // FAIL: Constructor specializations need a class template
}

class CCover<T> {
[pub]:
	ctor( T v ) { }
	[spec] ctor<X=int>( int v ) { } // FAIL: No matching constructor template in 'CCover'
}

class CSym<T> {
[pub]:
	ctor<U>( U u, T t ) { }
	[spec] ctor<T=U>( int u, int t ) { } // FAIL: Specialization of 'CSym' must bind 'T' to a concrete type
}

class CSig<T> {
[pub]:
	ctor( T v ) { }
	[spec] ctor<T=int>( int v, int b ) { } // FAIL: Specialization of the constructor of 'CSig' must repeat the primary's substituted parameters
}

// non-type binding kind validation
class BadKind<T> {
[pub]:
	ctor() {}
	func f() -> int => 0;
	[spec] func f<T=5>() -> int => 1; // FAIL: Specialization of 'f' must bind the type parameter 'T' to a type
	func g<int N>() -> int => N;
	[spec] func g<N=int>() -> int => 1; // FAIL: Specialization of 'g' must bind the non-type parameter 'N' to a value
}

// alias templates cannot be specialized (C++ has no spelling for it)
alias BadSpec<T> = BadSpec<T>;
[spec] alias BadSpec<T=int> = BadSpec<int>; // FAIL: Alias templates cannot be specialized

// member variable specialization validation (class params first, at least one own param bound)
class MVBox<T> {
[pub]:
	[static] field const T y<U> = (U)0;
	[static] field const T y<U=int> = 1; // FAIL: Specialization of 'y' must bind all class template parameters
}

class MVOpen<T> {
[pub]:
	[static] field const T z<U> = (U)0;
	[static] field const T z<T=int> = 1; // FAIL: Specialization of 'z' must bind at least one of 'MVOpen's own template parameters
}

class MVSpec<T> {
[pub]:
	[static] field const T w<U> = (U)0;
}

[spec=all] class MVSpec<T=int> {
[pub]:
	[static] field const T w<U=int> = 1; // FAIL: Specialization of 'w' sits inside the specialization
}

class MVStatic<T> {
[pub]:
	field const T n<U> = (U)0; // FAIL: Member variable templates must be [static]
}

class MVStaticSpec<T> {
[pub]:
	[static] field const T m<U> = (U)0;
	[static] field const T m<T=int, U=int> = 1;
	field const T m2<T=int, U=int> = 2; // FAIL: Member variable templates must be [static]
}

class MVDeep {
[pub]:
	class Mid {
	[pub]:
		class Deep<V> { field V v; }
		[spec=all] class Deep<V=int> { field int v; } // FAIL: Specializations of nested classes inside another nested class are not supported yet
	}
}


// Alias template argument kind checks (compile-stage).
namespace tplfail_alias {
	alias Vec<T> = std::vector<T>;
	alias FixedArray<T, int N> = std::array<T, N>;
}

func test_type_arg_for_type_param() -> void {
	var tplfail_alias::Vec<42> a; // FAIL: Template argument kind mismatch
}

func test_value_arg_for_non_type_param() -> void {
	var tplfail_alias::FixedArray<float, int> b; // FAIL: Template argument kind mismatch
}

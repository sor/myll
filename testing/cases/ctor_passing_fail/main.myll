// Copy/move constructor template rejection (compile-stage diagnostics): C++
// forbids copy/move constructor templates, and the passing forms take no
// parameter lists, so a type parameter there is always a mistake.
module ctor_passing_fail;

class CCopy {
[pub]:
	ctor copy<int> { } // FAIL: 'copy' constructors cannot be parameterized
	ctor move<T> other { } // FAIL: 'move' constructors cannot be parameterized
	ctor() {}
}
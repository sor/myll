module ct_array_size;

import ct_array_size_ctlib, ct_array_size_lib;

[ct] const int SIZE = 4;

struct S {
[pub]:
	field {
		int[SIZE] arr;
	}
}

func main() -> int {
	var S s;
	s.arr[0] = 1;
	s.arr[SIZE - 1] = 2;

	if( s.arr[0] != 1 )
		return 1;
	if( s.arr[SIZE - 1] != 2 )
		return 2;

	var int[SIZE] local;
	local[0] = 3;
	if( local[0] != 3 )
		return 3;

	// a constexpr function from another module as a constant size
	var int[dbl( 4 )] imported;
	imported[7] = 4;
	if( imported[7] != 4 )
		return 4;

	// plain imported function (runtime)
	if( triple( 6 ) != 18 )
		return 5;

	return 0;
}

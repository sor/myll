module ct_array_size;

[ct] const int SIZE = 4;

struct S {
[pub]:
	field {
		int[SIZE] arr;
	}
}

func main() -> int {
	var S s;
	s.arr[0] = 1;
	s.arr[SIZE - 1] = 2;

	if( s.arr[0] != 1 )
		return 1;
	if( s.arr[SIZE - 1] != 2 )
		return 2;

	var int[SIZE] local;
	local[0] = 3;
	if( local[0] != 3 )
		return 3;

	return 0;
}

module ctad_fail;

class NoDeduce<T>
{
[pub]:
	ctor( int v ) { _v = v; }

	field T _v;
}

class Box<T>
{
[pub]:
	ctor( T* p, int q ) { _v = q; }
	ctor( T q, int* p ) { _v = 0; }

	field T _v;
}

func main() -> int
{
	var int x = 5;

	// T appears in no constructor parameter
	var NoDeduce n( 1 ); // FAIL: Could not deduce template arguments for 'NoDeduce'

	// A bare type without construction is not CTAD
	var Box b; // FAIL: Template argument count mismatch for type 'Box'

	// ctor(T*, int) deduces Box<int>, ctor(T, int*) deduces Box<int*> and the
	// guides are incomparable: neither list deduces from the other
	var Box a( &x, 7 ); // FAIL: Ambiguous template argument deduction for 'Box'

	return 0;
}
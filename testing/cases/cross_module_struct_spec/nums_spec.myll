module nums_spec;

import nums;

[spec=all] class Box<T=int>
{
[pub]:
	field int _value;
	field int _extra;
	ctor( int v, int e ) { _value = v; _extra = e; }
	func read() -> int => _value + _extra;
}

[spec=all] class Pair<T, U=int>
{
[pub]:
	field T _a;
	field int _sum;
	ctor( T a, int s ) { _a = a; _sum = s; }
}

// Cross-module pattern specialization: pointer instantiations pick this body
[spec=all] class Box<T=T*>
{
[pub]:
	field int _value;
	ctor( int v ) { _value = v; }
	func read() -> int => _value * 2;
}

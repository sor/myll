module main;

import nums, nums_spec;

func main() -> int
{
	var Box<int> b( 3, 4 );
	if( b.read() != 7 )
		return 1;

	var Box<f32> p;
	p._value = 1.5;
	if( p.read() < 1.4 )
		return 2;

	var Pair<f32, int> q( 9.5, 6 );
	if( q._sum != 6 )
		return 3;

	var Box<int*> pb( 21 );
	if( pb.read() != 42 )
		return 4;
	return 0;
}

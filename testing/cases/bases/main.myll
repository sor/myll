class A {
	field int a = 1;
}

class B {
	field int b = 2;
}

class C {
	field int c = 3;
}

class PubDef : A {
}

class Priv : [priv] A {
}

class Prot : [prot] A {
}

class Virt : [virtual] A {
}

class PubVirt : [pub, virtual] A {
}

class Multi : [pub] A, [priv] B, [virtual] C {
}

func main() -> int {
	return 0;
}

module alias_template;
import std_vector;
import std_array;
import alias_lib;
import alias_types;

func test_vec() -> int {
	var alias_lib::Vec<int> v;
	v.push_back( 42 );
	if( v.size() != 1 )
		return 1;
	if( v[0] != 42 )
		return 2;
	return 0;
}

func test_fixed_array() -> int {
	var alias_lib::FixedArray<int, 4> arr;
	if( arr.size() != 4 )
		return 3;
	arr[0] = 7;
	if( arr[0] != 7 )
		return 4;
	return 0;
}

func test_pair_aliases() -> int {
	var alias_types::P<int, f32> p;
	p.first = 1;
	p.second = 2.5;
	if( p.first != 1 )
		return 5;
	if( p.second < 2.4 || p.second > 2.6 )
		return 6;

	var alias_types::IntPair<f32> ip;
	ip.first = 8;
	ip.second = 9.0;
	if( ip.first != 8 )
		return 7;
	if( ip.second < 8.9 || ip.second > 9.1 )
		return 8;

	return 0;
}

func test_alias_chain() -> int {
	var alias_types::VecAlias<int> v;
	v.push_back( 100 );
	if( v.size() != 1 || v[0] != 100 )
		return 9;
	return 0;
}

func test_pointer_alias() -> int {
	var int x = 123;
	var alias_types::IntPtr p = &x;
	if( *p != 123 )
		return 10;
	return 0;
}

func main() -> int {
	var int r = test_vec();
	if( r != 0 )
		return r;

	r = test_fixed_array();
	if( r != 0 )
		return r;

	r = test_pair_aliases();
	if( r != 0 )
		return r;

	r = test_alias_chain();
	if( r != 0 )
		return r;

	r = test_pointer_alias();
	if( r != 0 )
		return r;

	return 0;
}

module synthetic_sugar;

func check_continue_if() -> int
{
	var int sum = 0;
	var int a = 0;
	for( a = 0; a < 10; ++a ) {
		do continue if( a % 2 == 0 );
		sum = sum + a;
	}
	if( sum != 1 + 3 + 5 + 7 + 9 )
		return 1;

	var int innerHits = 0;
	var int b = 0;
	for( b = 0; b < 3; ++b ) {
		var int j = 0;
		while( j < 10 ) {
			do continue 2 if( j == 1 );
			innerHits = innerHits + 1;
			++j;
		}
	}
	if( innerHits != 3 )
		return 2;

	return 0;
}

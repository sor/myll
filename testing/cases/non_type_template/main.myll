module non_type_template;

import array_checks;

func add<int N>( int x ) -> int {
	return x + N;
}

const int twice<int N> = N * 2;

// non-type specialization bindings: N=8 binds the value parameter
const int twice<N=8> = 5;

// folded constant expressions fold to their value: N=4+5 binds N=9
const int folded<int N> = N;
const int folded<N=4+5> = 111;

// mixed type and non-type class specialization
class Fixed<T, int N> {
[pub]:
	ctor() {}
	func len() -> int => N;
	func first() -> T => 0;
}

class Fixed<T=int, N=1+2> {
[pub]:
	ctor() {}
	func len() -> int => 30;
	func first() -> int => 1;
}

func main() -> int {
	if( add<5>( 10 ) != 15 )
		return 1;
	if( twice<21> != 42 )
		return 2;
	if( array_checks::checkStdArray() != 0 )
		return 3;
	if( twice<8> != 5 )
		return 4;
	if( folded<9> != 111 )
		return 5;
	if( folded<4+5> != 111 ) // folded use args match folded specs
		return 6;
	if( folded<0 - 5> != -5 ) // spaced minus folds to -5, stays primary
		return 7;
	if( twice<4> != 8 )
		return 6;

	var Fixed<int, 3> f;
	if( f.len() != 30 )
		return 8;
	if( f.first() != 1 )
		return 9;
	var Fixed<f32, 9> g;
	if( g.len() != 9 )
		return 10;
	var Fixed<f64, 2*2> h; // folded use arg: 4
	if( h.len() != 4 )
		return 11;

	return 0;
}

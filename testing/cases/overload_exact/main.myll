module overload_exact;

func pick( int value ) -> int
{
	return 1;
}

func pick( u64 value ) -> int
{
	return 2;
}

func pick( bool value ) -> int
{
	return 3;
}

func main() -> int
{
	var int  a = 0;
	var u64  b = 0;
	var bool c = false;

	if( pick( a ) != 1 )
		return 1;

	if( pick( b ) != 2 )
		return 2;

	if( pick( c ) != 3 )
		return 3;

	return 0;
}

// Declared specializations: this prototype module says the real header
// (somelib.hpp) already specializes Somelib::Box for int. Myll resolves uses
// against the specialized member set and rejects re-specialization; nothing
// is emitted for this module.
module somelib;

import "somelib.hpp";

namespace Somelib {
	class Box<T> {
	[pub]:
		ctor();

		field T _v;

		func Get() -> T => _v;
	};

	class Box<T=int> {
	[pub]:
		ctor();

		field int _v;
		field int _extra;

		func Get() -> int => _v + _extra;
	};
}
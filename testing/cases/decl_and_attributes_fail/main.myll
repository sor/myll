[static] var int staticGlobal = 1; // FAIL: [static] is valid only on class fields

[inline, hide] var int inlineHiddenGlobal = 2; // FAIL: [inline] and [hide] are mutually exclusive

[extern] var const int externConstGlobal = 3; // FAIL 2

[default] func freeDefault() -> void { } // FAIL: [default] is only valid on special member functions

struct DeclAttrTest {
[pub]:
	[hide] var int hiddenField; // FAIL: [hide]/[hidden] is only valid at module/namespace scope
	[inline] var int inlineNonStaticField; // FAIL: [inline] on a class field requires [static]
	var int dupField;
	var int dupField; // FAIL: Duplicate variable/field declaration
}

class ChainC {
[pub]:
	[chain]
	method foo() -> ChainC& { return self; } // FAIL: must not declare a return type
}

[rule_of_3]
struct RuleOfBad { // FAIL: does not satisfy the required rule-of-N
[pub]:
	field { int[]! _data; }

	ctor() {}
	dtor() {}
	ctor( const RuleOfBad & other ) {
		_data = new int[1]!;
		_data[0] = other._data[0];
	}
}

// The bare spelling still requires one of the rules to hold.
[rule_of_n]
struct RuleOfAnyBad { // FAIL: does not satisfy the required rule-of-N
[pub]:
	field { int[]! _data; }

	ctor copy {
		_data = new int[1]!;
		_data[0] = other._data[0];
	}
}

func main() -> int {
	return 0;
}

[flags]
enum FlagsNegative {
	A = -3 // FAIL: '[flags]enum' value must be a non-negative integer
}

class DefaultCtorBody
{
[default]
	ctor() { } // FAIL: Defaulted or deleted constructors must be declared with ';'
}

class ConvertNoAttr
{
[pub]:
	field int i;

	[spec] ctor convert <- int { i = other; } // FAIL: convert declaration must be [implicit] or [explicit]
}

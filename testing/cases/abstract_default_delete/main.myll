module main;

class Base
{
[pub]:
	[abstract]
	func compute() -> int;
}

class Derived : Base
{
[pub]:
	[override]
	func compute() -> int => 42;
}

class Resource
{
	field int _value;

[pub]:
	ctor( int v ) { _value = v; }

	[default]
	operator copy = other;

	func value() -> int => _value;
}

struct Config
{
	field {
		bool flag = true;
		int  count = 7;
	}
}

func dispatch( int x ) -> int => x + 1;

[delete]
func dispatch( f32 x ) -> int;

func main() -> int
{
	var Derived d;
	if( d.compute() != 42 )
		return 1;

	var Resource a = Resource( 10 );
	var Resource b = Resource( 20 );
	b = a;
	if( b.value() != 10 )
		return 2;

	var Config cfg;
	if( !cfg.flag || cfg.count != 7 )
		return 3;

	if( dispatch( 5 ) != 6 )
		return 4;

	return 0;
}

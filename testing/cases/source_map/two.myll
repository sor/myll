module source_map;

namespace NSTwo {
	class Two {
		var int value = 20;

		ctor() {}
		ctor( int v ) { value = v; }
		dtor() {}

		func twice() -> int => value * 2;
	};

	class Wrapper<T> {
		var T value;

		ctor( T v ) { value = v; }
		dtor() {}

		func unwrap() -> T { return value; }
	};
}

func twoValue() -> int {
	return 2;
}

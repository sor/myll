func test_narrowing_initializer() -> void {
	// 1000 does not fit in i8.
	var i8 x = 1000; // FAIL: Cannot convert 'untyped integer' to 'std::int8_t'
}

func test_pointer_to_array_initializer() -> void {
	// Gaining array-view rights from a raw pointer is an explicit cast
	// (const char[*]); it does not convert implicitly.
	var const char* p = "abc";
	var const char[*] q = p; // FAIL: Cannot convert 'const char*' to 'const char*'
}

func test_float_to_int_init() -> void {
	// No implicit float literal -> int conversion.
	var int y = 3.0; // FAIL: Cannot convert 'untyped float' to 'int'
}

func test_typed_int_to_float_init() -> void {
	// No implicit typed int -> f32 conversion.
	var int a = 3;
	var f32 z = a; // FAIL: Cannot convert 'int' to 'float'
}

func test_return_type_mismatch() -> int {
	// Function promises int, but returns an f32 literal.
	return 1.0; // FAIL: Cannot return type 'untyped float' from function 'test_return_type_mismatch' expecting 'int'
}

func test_assignment_mismatch() -> void {
	var int a = 0;
	a = 1.0; // FAIL: Cannot convert 'untyped float' to 'int'
}

func test_i32_to_i16_narrowing() -> void {
	var i32 x = 100000;
	var i16 y = x; // FAIL: Cannot convert 'std::int32_t' to 'std::int16_t'
}

func test_signed_to_unsigned() -> void {
	var i32 a = -1;
	var u32 b = a; // FAIL: Cannot convert 'std::int32_t' to 'std::uint32_t'
}

func test_i64_to_i32_narrowing() -> void {
	var i64 c = -1;
	var i32 d = c; // FAIL: Cannot convert 'std::int64_t' to 'std::int32_t'
}

func test_char_as_number() -> void {
	var i32 e = 'x'; // FAIL: Cannot convert 'char' to 'std::int32_t'
}

func test_char_vs_int_literal_eq() -> void {
	var char c = 'a';
	if( c == 0 ) { } // FAIL: Cannot compare 'char' with 'untyped integer'
}

func test_char_vs_int_literal_order() -> void {
	var char c = 'a';
	if( c < 5 ) { } // FAIL: Cannot compare 'char' with 'untyped integer'
}

func test_char_vs_typed_int() -> void {
	var char c = 'a';
	var int n = 3;
	if( c == n ) { } // FAIL: Cannot compare 'char' with 'int'
}

func test_char_vs_int_literal_mirrored() -> void {
	var char c = 'a';
	if( 0 == c ) { } // FAIL: Cannot compare 'char' with 'untyped integer'
}

func test_char_vs_typed_int_order_ops() -> void {
	var char c = 'a';
	var int n = 3;
	if( c >= n ) { } // FAIL: Cannot compare 'char' with 'int'
}

func test_char_vs_typed_float() -> void {
	var char c = 'a';
	var f32 f = 1.5;
	if( c == f ) { } // FAIL: Cannot compare 'char' with 'float'
}

func test_compound_constant_overflow() -> void {
	// The folded value 1048576 does not fit in u8.
	var u8 small = 1024 * 1024; // FAIL: Cannot convert 'untyped integer' to 'std::uint8_t'
}

func test_if_integer_condition() -> void {
	var int i = 1;
	if( i ) { } // FAIL: Condition of 'if' must be bool
}

func test_logical_and_non_bool() -> void {
	var bool b = true;
	var int i = 0;
	if( b && i ) { } // FAIL: Condition of 'if' must be bool
}

func test_while_non_bool() -> void {
	var int count = 3;
	while( count ) { } // FAIL: Condition of 'while' must be bool
}

func test_do_while_non_bool() -> void {
	do { } while( 1 ); // FAIL: Condition of 'do-while' must be bool
}

func test_for_non_bool() -> void {
	for( var int i = 0; i; ++i ) { } // FAIL: Condition of 'for' must be bool
}

class SliceBase {
[pub]:
	method doSomething() -> int => 0;
}

class SliceDerived : SliceBase {
[pub]:
	method doSomething() -> int => 1;
}

func takeSliceBase( SliceBase b ) -> int => b.doSomething();

func test_object_slicing() -> int {
	var SliceDerived d;
	return takeSliceBase( d ); // FAIL 2
}

class ExplicitConvert {
[pub]:
	field int i;
	[explicit] ctor convert <- int { i = other; }
}

func test_explicit_convert_implicit_use() -> void {
	// Explicit conversions do not participate in implicit conversion.
	var ExplicitConvert e = 4; // FAIL: Cannot convert 'untyped integer' to 'ExplicitConvert'
}

func returns_auto_void() -> auto { } // FAIL: explicit '-> auto' but has no value-returning statement

func no_value_return() -> int { } // FAIL: declares return type 'int' but has no return or throw statement

func main() -> int {
	return 0;
}

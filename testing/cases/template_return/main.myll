// A call to a function template carries the substituted return type: deduction and
// explicit template arguments both replace the template parameter, so var auto and
// chained calls see the concrete type instead of a raw T.
module template_return;

func max<T>( T a, T b ) -> T
{
	ret = a > b ? a : b;
}

func unref<T>( T* p ) -> T*
{
	ret = p;
}

func take( int v ) -> int
{
	ret = v;
}

func main() -> int
{
	var auto m = max( 3, 4 );
	if( m != 4 ) return 1;

	var auto e = max( 5, 6 );
	if( e != 6 ) return 2;

	var auto m2 = max<int>( 1, 2 );
	if( m2 != 2 ) return 3;

	var int value = 10;
	var auto p = unref( &value );
	if( *p != 10 ) return 4;

	if( take( max( 9, 10 ) ) != 10 ) return 5;

	return 0;
}
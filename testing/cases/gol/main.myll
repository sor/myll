module game_of_life;

import game_of_life, std_iostream, std_thread, std_chrono, c_stdlib;

func main() -> int
{
	using JanSordid;

	// the literals themselves do not work e.g. 200ms
	//using std::chrono_literals;

	var std::chrono::milliseconds sleepTime = std::getenv( "MYLL_TEST" ) != null
		? std::chrono::milliseconds( 0 )
		: std::chrono::milliseconds( 166 );
	var GameOfLife gol;

	loop
	{
		gol.output( std::cout );
		std::cout.flush();
		gol.iterate();

		if( gol.hasConverged() )
			return 0;

		std::this_thread::sleep_for( sleepTime );

		clear();
	}

	return 42;
}

func clear()
{
	//[os=linux] std::system("clear");
	//[os=win32] std::system("cls");

	// poor man's clear screen
	do 30 times
		std::cout << "\n";
}

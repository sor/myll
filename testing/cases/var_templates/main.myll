module var_templates;

const T answer<T> = (T)42;
const T * ptrValue<T> = null;

// specializations: full (all parameters bound) and partial (subset bound, in
// primary parameter order)
const T pi<T> = (T)3.1415;
[spec] const T pi<T=int> = 3;
[spec] const T pi<T=f32> = (f32)3.5;

// partial specializations: full form (name every parameter) ...
const T q<T, U> = (T)7;
[spec] const T q<T, U=int> = (T)70;
[spec] const T q<T, U=f32> = (T)71;

// ... and the subset form (name only the bound ones), same semantics
const T z<T, U> = (T)17;
[spec] const T z<U=int> = (T)170;
[spec] const T z<U=f32> = (T)171;

// Same-tier specs rank by partial ordering: the pattern beats the plain
// unbound parameter for pointer arguments.
const T tv<T, U> = (T)0;
[spec] const T tv<T=int, U> = (T)1;
[spec] const T tv<T=int, U=U*> = (T)2;

// bound parameter names stay usable in the initializer: the (T) below names
// the bound parameter, which the alias expands to int
const T rtv<T> = (T)0;
[spec] const T rtv<T=int> = (T)21;

// runtime variable templates specialize as inline variables; constexpr is
// const-only and the extern-declaration split does not exist for them
var T rt<T> = (T)0;
[spec] var T rt<T=int> = 5;
var T rtq<T, U> = (T)7;
[spec] var T rtq<T, U=int> = (T)70;

// defaulted primary: bare uses and omitted trailing args fill
const T answer2<T=int> = 41;

// pattern specialization: pointer instantiations deduce T
const T sizeOf<T> = (T)0;
[spec=partial] const T sizeOf<T=T*> = (T)8;

// a shape assertion is optional: [spec=full] below declares every position
// concretely bound
const T sizeOf2<T> = (T)0;
[spec=full] const T sizeOf2<T=f32> = (T)4;

class Pair<T, U> {
[pub]:
	field {
		T first;
		U second;
	}
}

const Pair<T, T> pairDup<T> = Pair<T, T>();

func main() -> int {
	var int a = answer<int>;
	if( a != 42 )
		return 1;

	var f32 b = answer<f32>;
	if( b < 41.9 || b > 42.1 )
		return 2;

	var const int * p = ptrValue<int>;
	if( p != null )
		return 3;

	var Pair<int, int> pair = pairDup<int>;
	if( pair.first != 0 || pair.second != 0 )
		return 4;

	if( pi<int> != 3 )
		return 5;
	if( pi<f32> < 3.4 || pi<f32> > 3.6 )
		return 6;
	if( pi<i64> < 3.0 || pi<i64> > 3.2 )
		return 7;

	if( q<int, i64> != 7 )
		return 8;
	if( q<i64, int> != 70 )
		return 9;
	if( q<int, f32> != 71 )
		return 10;

	if( z<int, i64> != 17 )
		return 11;
	if( z<i64, int> != 170 )
		return 12;
	if( z<int, f32> != 171 )
		return 13;

	if( tv<int, f32> != 1 )
		return 20;
	if( tv<int, int*> != 2 ) // pattern beats unbound at the same tier
		return 21;
	if( tv<f32, f32> != 0 ) // primary
		return 22;

	if( rt<int> != 5 )
		return 14;
	if( rtv<int> != 21 ) // the initializer wrote (T), T bound to int
		return 15;
	if( rt<i64> != 0 )
		return 16;
	if( rtq<i64, int> != 70 )
		return 17;
	if( rtq<int, i64> != 7 )
		return 18;

	if( sizeOf<int> != 0 )
		return 19;
	if( answer2 != 41 )
		return 22;
	if( sizeOf<int*> != 8 )
		return 20;
	if( sizeOf2<f32> < 3.9 )
		return 21;

	return 0;
}

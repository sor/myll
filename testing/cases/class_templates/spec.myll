module class_templates;

namespace spec {

// full specialization: own member set, C++ style — bound names are not in
// scope, the body spells out the bound values
class Box<T>
{
[pub]:
	field T _value;
	[default] ctor();
	func read() -> T => _value;
}

[spec=all] class Box<T=int>
{
[pub]:
	field int _value;
	field int _extra;

[pub]:
	ctor( int v, int e ) { _value = v; _extra = e; }
	func read() -> int => _value + _extra;
}

// partial specialization: T stays a parameter, U is bound
class Pair<T, U>
{
[pub]:
	field T _a;
	field U _b;

	[default] ctor();
	func sum() -> T => _a;
}

[spec=all] class Pair<T, U=int>
{
[pub]:
	field T _a;
	field int _b;
	field int _sum;

	ctor( T a, int b ) { _a = a; _b = b; _sum = 0; }
	method add() -> Pair<T, int> {
		_sum = _sum + _b;
		return *this;
	}
}

// union specialization (unions keep their member default initializers off)
union Choice<T>
{
	field {
		T _val;
		int _idx;
	}
}

[spec=all] union Choice<T=f32>
{
	field {
		f32 _val;
		int _idx;
		f32 _alt;
	}
}

// Pattern specialization: the binding names a parameter with pointer
// decorations, the parameter stays open and deduces per use
[spec=primary] class PtrBox<T>
{
[pub]:
	field T _v;

	ctor( T v ) { _v = v; }
	func read() -> T => _v;
}

[spec=all] class PtrBox<T=T*>
{
[pub]:
	field T _v;

	ctor( T v ) { _v = v; }
	func read() -> T => _v + 1;
}

// A pattern over another parameter's positions; the named parameter deduces
[spec=all] class Pair<T, U=T*>
{
[pub]:
	field T _a;

	[default] ctor();
	func first() -> T => _a;
}

// The trait idiom: primary says false, the pattern says true for pointers
[spec=primary] class IsPtr<T>
{
[pub]:
	[static] field bool value = false;
}

[spec=all] class IsPtr<T=T*>
{
[pub]:
	[static] field bool value = true;
}

func run() -> int
{
	var Box<int> a( 3, 4 );
	if( a.read() != 7 )
		return 1;

	var Box<f32> b;
	b._value = 1.5;
	if( b.read() < 1.4 || b.read() > 1.6 )
		return 2;

	var Pair<f32, int> p( 1.5, 2 );
	p.add();
	if( p._sum != 2 )
		return 3;

	var Pair<f32, f32> q;
	q._a = 1.5;
	q._b = 2.5;
	if( q.sum() < 1.4 )
		return 4;

	var Choice<f32> c;
	c._alt = 9.5;
	if( c._alt < 9.0 || c._alt > 10.0 )
		return 5;

	var Choice<int> d;
	d._idx = 3;
	if( d._idx != 3 )
		return 6;

	// pattern specialization: pointer instantiations use the pattern body
	var PtrBox<int*> w( 41 );
	if( w.read() != 42 )
		return 7;

	// non-pointer instantiations stay with the primary
	var PtrBox<int> v( 7 );
	if( v.read() != 7 )
		return 8;

	// the trait idiom
	if( IsPtr<int>::value )
		return 9;
	if( !IsPtr<int*>::value )
		return 10;

	return 0;
}

// Method specializations: emitted out-of-line after the class (C++ rejects
// in-class), with the class parameters bound first. The class name inside a
// specialization stands for the specialized instantiation (OpBox<int>).
class Num {
[pub]:
	field int _v;

[pub]:
	ctor( int v ) { _v = v; }
	func Get<T>( T t ) -> T => t;
	func Get<T=int>( T t ) -> T => t + _v;
}

// Constructor templates compose inside class specializations: the class spec
// owns the members, and the ctor template keeps its own parameters.
class SpecBox<T> {
[pub]:
	field T _v;
	ctor( T v ) { _v = v; }
}

[spec=all] class SpecBox<T=int> {
[pub]:
	field int _v;
	ctor( int v ) { _v = v; }
	ctor<U>( U u, int v ) { _v = v + (int)u; }
}

// Bound parameter names stay usable in member signatures and bodies: the
// spec below writes T everywhere, which the bound alias expands to int.
class Rebind<T> {
[pub]:
	field T _v;
	ctor( T v ) { _v = v; }
	func twice() -> T => _v + _v;
}

[spec=all] class Rebind<T=int> {
[pub]:
	field T _v;
	ctor( T v ) { _v = v; }
	func twice() -> T => _v + _v;
}

class Store<T> {
[pub]:
	field T _v;

[pub]:
	ctor( T v ) { _v = v; }
	func Val( T t ) -> T => t;
	func Val<T=int>( T t ) -> T => t + _v;

	func Load<U>( U u ) -> U => u;
	func Load<T=int>( U u ) -> U => u + 1;
	func Load<T=int, U=int>( U u ) -> U => u + 3;
}

class OpBox<T> {
[pub]:
	field T _v;

[pub]:
	ctor( T v ) { _v = v; }
	operator +( OpBox other ) -> OpBox => OpBox( other._v + _v );
	operator +<T=int>( OpBox other ) -> OpBox => OpBox( other._v + _v + 100 );
}

// Member variable specializations bind class parameters first (like methods),
// emit out-of-line after the class, and require at least one own parameter
// bound. Member var templates are implicitly static in the emission because
// C++ only allows static member templates.
class Holder<T> {
[pub]:
	[static] field const T x<U> = (U)0;
	[static] const T x<T=int, U=int> = 7;
	class Inner<V> {
	[pub]:
		field V v;
	}
	[spec=all] class Inner<T=int, V=f32> {
	[pub]:
		field f32 w;
	}
}

// Constructor specializations and constructor templates: ctor specs bind
// class parameters first and emit out-of-line like method specs; ctor template
// arguments are always deduced.
class Wrap<T> {
[pub]:
	field T _v;

	ctor( T v ) { _v = v; }
	ctor<T=int>( T v ) { _v = v + 100; }

	ctor<U>( U u, T t ) { _v = t; }
	ctor<T=f32, U=i32>( i32 u, f32 t ) { _v = t + 1.5; }
}

func run4() -> int
{
	var Holder<int> h;
	if( Holder<int>::x<int> != 7 ) // member var spec via qualified name
		return 1;
	if( h.x<int> != 7 ) // member var spec via member access
		return 2;
	var Holder<f32> h2;
	if( h2.x<int> != 0 ) // primary via member access
		return 3;
	var Holder<int>::Inner<f32> i;
	if( i.w < 0.0 || i.w > 0.1 ) // nested class spec
		return 4;
	var Holder<f32>::Inner<i32> j;
	if( j.v != 0 ) // nested class primary
		return 5;
	return 0;
}

func run3() -> int
{
	var Wrap<int> a( 1 );
	if( a._v != 101 ) // ctor spec via class args
		return 1;
	var Wrap<f32> b( 2.5 );
	if( b._v < 2.4 ) // primary via class args
		return 2;
	var Wrap<f32> d( 1, 2.5 );
	if( d._v < 3.9 || d._v > 4.1 ) // fully bound ctor spec
		return 3;
	var Wrap<i64> e( 4, 5 );
	if( e._v != 5 ) // ctor template
		return 4;
	var Wrap<i64> f = Wrap<i64>( 6, 7 );
	if( f._v != 7 )
		return 5;

	var SpecBox<int> sa( 3 );
	if( sa._v != 3 ) // class spec ctor
		return 6;
	var SpecBox<int> sb( 1.5, 4 );
	if( sb._v != 5 ) // ctor template inside the class spec
		return 7;

	var Rebind<int> r( 21 );
	if( r.twice() != 42 ) // members written with the bound name
		return 8;
	return 0;
}

func run2() -> int
{
	var Num n( 2 );
	if( n.Get( 40 ) != 42 ) // spec via deduction
		return 1;
	if( n.Get<f32>( 1.5 ) < 1.4 ) // primary via explicit args
		return 2;

	var Store<int> s( 100 );
	if( s.Val( 1 ) != 101 ) // class+method spec via receiver and deduction
		return 3;
	if( s.Load( 1 ) != 4 ) // the fully bound spec wins over the open one
		return 4;
	if( s.Load<f32>( 2.5 ) < 3.4 ) // open member spec via explicit member args
		return 5;

	var Store<f32> t( 1.5 );
	if( t.Val( 2.5 ) < 2.4 ) // primary
		return 6;
	if( t.Load( 1 ) != 1 ) // no spec matches: primary
		return 7;

	var OpBox<int> a( 1 );
	var OpBox<int> b( 2 );
	var OpBox<int> r = a + b;
	if( r._v != 103 ) // operator spec
		return 8;
	return 0;
}

} // namespace spec
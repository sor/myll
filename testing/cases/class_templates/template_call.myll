module class_templates;

import std_string;

namespace template_call {

class Wrapper<T>
{
[pub]:
	method foo<U>() -> U
	{
		var U value;
		return value;
	}

	method bar() -> int
	{
		// `self` has dependent type `Wrapper<T>`, so the generated C++ needs
		// `this->template foo<int>()` (or `(*this).template foo<int>()`).
		return self.foo<int>();
	}
}

class Carrier
{
[pub]:
	method toType<T>( T v ) -> T => v;

	field int _marker;
}

func run() -> int
{
	var Wrapper<int> w;
	var int r = w.bar();

	// Chaining a member call on the return of an explicitly instantiated
	// template method: the return type substitutes, then the member resolves.
	var Carrier carrier;
	var usize n = carrier.toType<string>( "hi" ).length();
	if( n != 2 )
		return 1;
	var char c = carrier.toType<string>( "abc" )[ 0 ];
	if( c != 'a' )
		return 2;

	return r;
}

} // namespace template_call

module main;

func main() -> int
{
	var int i = 0;
	var int sum = 0;
	var int count = 0;

	// empty body
	for( ; i < 3; ++i )
		;

	while( ++count < 3 )
		;

	// single-statement body
	i = 0;
	for( ; i < 3; ++i )
		sum = sum + 1;

	count = 0;
	while( count < 3 )
		++count;

	// multiple-statement body
	i = 0;
	for( ; i < 3; ++i ) {
		sum = sum + 1;
		count = count + 1;
	}

	count = 0;
	while( count < 3 ) {
		++count;
		sum = sum + 1;
	}

	// single-statement do-while body
	count = 0;
	do
		++count;
	while( count < 3 );

	// multiple-statement do-while body
	count = 0;
	do {
		++count;
		sum = sum + 1;
	} while( count < 3 );

	// continue statement
	i = 0;
	var int contSum = 0;
	while( i < 5 ) {
		++i;
		if( i == 2 )
			continue;
		contSum = contSum + i;
	}

	return 0;
}

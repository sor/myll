module operator_defaults_fail;

// Arithmetic operators are pure (const) by default, so mutating `this` inside
// operator+ is a C++ compile-time error.
struct Num {
    field int v;

    ctor( int value ) { v = value; }

    operator + ( const Num & other ) -> Num {
        v = v + other.v;
        return Num( v );
    }
}

func main() -> int {
    var Num a = Num( 1 );
    var Num b = Num( 2 );
    var Num c = a + b;
    return 0;
}

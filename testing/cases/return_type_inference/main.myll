module main;

func noReturn()
{
	// inferred void
}

func inferInt( int x )
{
	if( x > 0 )
		return 42;
	return 0;
}

func inferUnsigned( u8 a, u32 b )
{
	if( a > 0 )
		return a;
	return b;
}

class Counter
{
	field {
		int value;
	}
[pub]:
	ctor()
	{
		value = 0;
	}

	[chain]
	method add( int x )
	{
		value += x;
	}

	[chain, pure]
	method peek()
	{
		// returns const Counter&
	}

	method retrieve() => value;
}

func main() -> int
{
	noReturn();

	var int a = inferInt( 1 );
	if( a != 42 )
		return 1;

	var u8 small = 1;
	var u32 big  = 100;
	var u32 b = inferUnsigned( small, big );
	if( b != 1 )
		return 2;

	var Counter c;
	c.add( 1 ).add( 2 ).add( 3 );
	c.peek();

	return c.retrieve() - 6;
}

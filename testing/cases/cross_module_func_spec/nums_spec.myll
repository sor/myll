// Cross-module function specializations: the primary lives in nums; this
// module imports it and adds full specializations. The generated header
// includes nums.hpp, so the primary precedes every specialization.
module nums_spec;

import nums;

[spec] func half<T=int>( T a ) -> T => a * 2;

[spec] func combine<T=int, U=f32>( int a, f32 b ) -> int => a * 100 + (int)b;

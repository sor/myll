module main;

import nums, nums_spec;

func main() -> int
{
	// deduction picks the specializations
	if( half( 21 ) != 42 )
		return 1;
	if( combine( 2, 3.5 ) != 203 )
		return 2;

	// primary instantiations for other arguments
	if( half( 2.5 ) < 2.4 || half( 2.5 ) > 2.6 )
		return 3;
	if( combine( 2.5, 3.5 ) != 2.5 )
		return 4;

	// explicit template arguments pick the specialization
	if( half<int>( 3 ) != 6 )
		return 5;
	return 0;
}
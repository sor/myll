module overload_non_template;

namespace overload_pointer {

func take( int value ) -> int { return 1; }
func take( int * value ) -> int { return 2; }

func run() -> int
{
	var int x = 0;

	if( take( x ) != 1 )
		return 1;

	if( take( &x ) != 2 )
		return 2;

	return 0;
}

} // namespace overload_pointer

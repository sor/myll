module overload_non_template;

namespace overload_template_ranking {

func generic<T>( T value ) -> int { return 1; }
func generic( int value ) -> int { return 2; }
func generic( int * value ) -> int { return 3; }

func run() -> int
{
	if( generic( 42 ) != 2 )
		return 1;

	var int x = 0;
	if( generic( &x ) != 3 )
		return 2;

	if( generic( 3.14 ) != 1 )
		return 3;

	return 0;
}

}
module overload_non_template;

func main() -> int
{
	if( overload_main::run()                   != 0 ) return 1;
	if( overload_exact::run()                  != 0 ) return 2;
	if( overload_simple::run()                 != 0 ) return 3;
	if( overload_pointer::run()                != 0 ) return 4;
	if( overload_const_ptr::run()              != 0 ) return 5;
	if( overload_const_ref::run()              != 0 ) return 6;
	if( ref_binding::run()                     != 0 ) return 7;
	if( ref_category::run()                    != 0 ) return 8;
	if( overload_inheritance_ptr::run()        != 0 ) return 9;
	if( overload_inheritance_ref::run()        != 0 ) return 10;
	if( overload_inheritance_conversion::run() != 0 ) return 11;
	if( overload_smart_ptr::run()              != 0 ) return 12;
	if( overload_smart_inheritance::run()      != 0 ) return 13;
	if( overload_template::run()             != 0 ) return 14;
	if( overload_template_ranking::run()     != 0 ) return 15;
	return 0;
}

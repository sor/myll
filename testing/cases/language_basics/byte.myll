module language_basics;

func check_byte() -> int
{
	var byte a = 0x0F;
	var byte b = 0x33;

	if( ( a + b ) != 0x3F ) return 1;
	if( ( a * b ) != 0x03 ) return 2;
	if( ( a - b ) != 0x0C ) return 3;
	if( ( a / b ) != 0xF3 ) return 4;
	if( ( a ^ b ) != 0x3C ) return 5;
	if( ( a | b ) != 0x3F ) return 6;
	if( ( a & b ) != 0x03 ) return 7;
	if( ( a << 1 ) != 0x1E ) return 8;
	if( ( a >> 1 ) != 0x07 ) return 9;
	if( ( ~a ) != 0xF0 ) return 10;

	return 0;
}

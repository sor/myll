module language_basics;

enum Test {
	A,
	B,
	C
}

enum TestComma {
	A,
	B,
	C,
}

enum TestNumbered {
	A = 1,
	B = 2,
	C = 3
}

enum TestNumberedComma {
	A = 1,
	B = 2,
	C = 3,
}

enum TestNumberedPartially {
	A = 1,
	B,
	C
}

[flags]
enum TestFlags {
	A,
	B,
	C
}

[flags]
enum TestFlagsNumbered {
	A = 1,
	B = 2,
	C = 4
}

[flags]
enum TestFlagsNumberedPartially {
	A = 4,
	B,
	C
}

[flags]
enum TestFlagsHex {
	A = 0x4,
	B = 0x10,
	C
}

[flags]
enum TestFlagsComposite {
	Red,
	Green,
	Blue,
	Yellow = Red | Green,
	Mask = Red | Green | Blue,
	Extra
}

func check_enum() -> int
{
	var Test basic = Test::A;
	var TestComma basicComma = TestComma::B;

	if( (int)(basic) != 0 || (int)(basicComma) != 1 )
		return 1;

	if( (int)(TestNumbered::A) != 1 || (int)(TestNumberedComma::A) != 1 || (int)(TestNumberedPartially::A) != 1 )
		return 2;

	if( (int)(TestNumbered::B) != 2 || (int)(TestNumbered::C) != 3 )
		return 3;

	if( (int)(TestNumberedComma::B) != 2 || (int)(TestNumberedComma::C) != 3 )
		return 4;

	if( (int)(TestNumberedPartially::B) != 2 || (int)(TestNumberedPartially::C) != 3 )
		return 5;

	if( (int)(TestFlags::A) != 1 || (int)(TestFlags::B) != 2 || (int)(TestFlags::C) != 4 )
		return 6;

	if( (int)(TestFlagsNumbered::A) != 1 || (int)(TestFlagsNumbered::B) != 2 || (int)(TestFlagsNumbered::C) != 4 )
		return 7;

	// especially test the offsetted auto-numbered flag values: A=4, B=8, C=16
	if( (int)(TestFlagsNumberedPartially::B) != 8 || (int)(TestFlagsNumberedPartially::C) != 16 )
		return 8;

	// hex flag values parse, and auto numbering continues after them: C = 32
	if( (int)(TestFlagsHex::A) != 4 || (int)(TestFlagsHex::B) != 16 || (int)(TestFlagsHex::C) != 32 )
		return 9;

	// composite flag values are emitted as-is and leave the auto chain transparent
	if( (int)(TestFlagsComposite::Red) != 1 || (int)(TestFlagsComposite::Green) != 2 || (int)(TestFlagsComposite::Blue) != 4 )
		return 10;
	if( (int)(TestFlagsComposite::Yellow) != 3 || (int)(TestFlagsComposite::Mask) != 7 || (int)(TestFlagsComposite::Extra) != 8 )
		return 11;

	return 0;
}

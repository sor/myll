module globals_ns;

namespace MyNs
{
	var int normalNs = 10;
	[inline] var int inlineNs = 20;
	const int constNs = 30;
	[ct] const int ctNs = 40;
}

func ns_check() -> int
{
	static_assert(MyNs::ctNs == 40, "ctNs must be 40");

	if( MyNs::normalNs != 10 )
		return 1;
	if( MyNs::inlineNs != 20 )
		return 2;
	if( MyNs::constNs != 30 )
		return 3;
	if( MyNs::ctNs != 40 )
		return 4;

	return 0;
}

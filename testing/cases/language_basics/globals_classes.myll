module globals_classes;

// Definition for the external variable declared in globals_extern
var int extGlobal = 7;

class Cls
{
[pub]:
	[static, inline] var int inlineField = 7;
	[static] var int normalField = 11;
	[static, ct] var int ctField = 123;
}

func cls_check() -> int
{
	static_assert(Cls::ctField == 123, "ctField must be 123");

	if( Cls::inlineField != 7 )
		return 1;
	if( Cls::normalField != 11 )
		return 2;
	if( Cls::ctField != 123 )
		return 3;

	return 0;
}

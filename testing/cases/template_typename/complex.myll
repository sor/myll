module template_typename;

class ComplexOuter<T>
{
[pub]:
	class Item<U>
	{
	[pub]:
		field T key;
		field U value;
	}
}

func makeComplex<T, U>( T k, U v ) -> ComplexOuter<T>::Item<U>
{
	var ComplexOuter<T>::Item<U> item;
	item.key = k;
	item.value = v;
	return item;
}

func duplicateComplex<T, U>( ComplexOuter<T>::Item<U> src ) -> ComplexOuter<T>::Item<U>
{
	return src;
}

func checkComplex() -> int
{
	var ComplexOuter<int>::Item<f32> a = makeComplex<int, f32>( 1, 3.14 );
	var ComplexOuter<int>::Item<f32> b = duplicateComplex<int, f32>( a );
	return ( b.key == 1 && b.value > 3.13 && b.value < 3.15 ) ? 0 : 1;
}

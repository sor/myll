module flags;

[flags]
enum TestFlags {
	A,
	B,
	C
}

[flags]
enum TestFlagsNumbered {
	A = 1,
	B = 2,
	C = 4
}

[flags]
enum TestFlagsNumberedPartially {
	A = 4,
	B,
	C
}

[inline]
func flags_test() -> int
{
	if( (int)(TestFlags::A) != 1 || (int)(TestFlags::B) != 2 || (int)(TestFlags::C) != 4 )
		return 1;

	if( (int)(TestFlagsNumbered::A) != 1 || (int)(TestFlagsNumbered::B) != 2 || (int)(TestFlagsNumbered::C) != 4 )
		return 1;

	// especially test the offsetted auto-numbered flag values: A=4, B=8, C=16
	if( (int)(TestFlagsNumberedPartially::B) != 8 || (int)(TestFlagsNumberedPartially::C) != 16 )
		return 1;

	return 0;
}

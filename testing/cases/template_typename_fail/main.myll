module template_typename_fail;

class Wrapper<T>
{
[pub]:
	class Inner
	{
	[pub]:
		field T value;
	}
}

func make<T>( T v ) -> Wrapper<T>::Inner
{
	var Wrapper<T>::Inner result;
	result.value = v;
	return result;
}

func main() -> int
{
	var Wrapper<int>::Inner x = make<int>( 99 );
	return x.value == 99 ? 0 : 1;
}

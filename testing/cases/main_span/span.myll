module main_span;

import std_span;

func spanSum( std::span<const int> values ) -> int
{
	var int total = 0;
	var u64 i = 0;
	while( i < values.size() ) {
		total = total + values[i];
		++i;
	}
	return total;
}

func spanFirstOf( const std::span<const int> & values ) -> int
	=> values[0];

func run_span_checks() -> int
{
	var int[5] data = [1, 2, 3, 4, 5];
	var std::span<const int> view( data, 5 );

	if( spanSum( view ) != 15 )
		return 1;

	if( view.size() != 5 )
		return 2;

	if( view[0] != 1 )
		return 3;

	if( view[4] != 5 )
		return 4;

	if( spanFirstOf( view ) != 1 )
		return 5;

	var const int[*] ptr = view.data();
	if( ptr[0] != 1 )
		return 6;
	if( ptr[4] != 5 )
		return 7;

	return 0;
}
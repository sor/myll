module convert_string;

import std_string;

func takesString( const std::string & s ) -> bool
{
	return s == "hello";
}

func main() -> int
{
	const string s = "hello";           // convert <- const char*
	if( s != "hello" )
		return 1;

	if( !takesString( "hello" ) )       // argument conversion
		return 2;

	return 0;
}

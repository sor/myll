module control_flow;
import std_exception;
import std_string;

func check_try_catch() -> int
{
	// catch a typed exception
	try {
		throw 42;
	}
	catch( int x ) {
		if( x != 42 )
			return 1;
	}

	// catch-all
	try {
		throw 7;
	}
	catch() {
		// expected
	}

	// catch with reference-like parameter
	try {
		throw 123;
	}
	catch( int y ) {
		if( y != 123 )
			return 2;
	}

	// multiple catch clauses: most-derived first
	try {
		throw std::exception();
	}
	catch( const std::exception & e ) {
		if( e.what() == null )
			return 3;
	}
	catch() {
		return 4;
	}

	return 0;
}

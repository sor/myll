// The function specialization ODR guard case: the two violations rejected as
// hard errors. (1) nums calls half<int> but cannot see the specializations
// that spec_a and spec_b attach to it: its translation unit would instantiate
// the primary while theirs use the specializations. (2) spec_a and spec_b
// both specialize half for int.
module nums;

func half<T>( T a ) -> T => a;

func probe() -> int
{
	var int p = half( 21 ); // FAIL: 'half' is specialized for T=int in module 'spec_a'
	return p;
}

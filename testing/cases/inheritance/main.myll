module main;

class Base
{
	field int _baseField = 7;

[pub]:
	method baseOnly() -> int => _baseField;

	[virtual]
	method compute( int x ) -> int => x + 1;
}

class Derived : Base
{
[pub]:
	[override]
	method compute( int x ) -> int => x * 10;
}

func useBasePointer( Base * b ) -> int => b->compute( 3 );
func useBaseReference( Base & b ) -> int => b.compute( 4 );

func main() -> int
{
	var Derived d;

	if( d.baseOnly() != 7 )
		return 1;

	if( useBasePointer( &d ) != 30 ) // 3*10
		return 2;

	if( useBaseReference( d ) != 40 ) // 4*10
		return 3;

	return 0;
}

module non_type_template_fail;

class Box<T> {
[pub]:
	field {
		T value;
	}
}

func identity<T>( T x ) -> T {
	return x;
}

const T answer<T> = (T)42;

func add<int N>( int x ) -> int {
	return x + N;
}

func main() -> int {
	var Box<42> a;                 // FAIL: expects a type
	var int b = identity<42>( 1 ); // FAIL: expects a type
	var int c = answer<42>;        // FAIL: expects a type
	var int d = add<int>( 10 );    // FAIL: expects a non-type value
	return 0;
}

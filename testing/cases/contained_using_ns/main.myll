import std_vector;

namespace LocalNS {
	func localValue() -> int { return 21; }
}

using LocalNS;
using std;

class Container {
	using std;

[pub]:
	field vector<int> values;

	ctor() {
		values.push_back( 1 );
		values.push_back( 2 );
		values.push_back( 3 );
	}

	method sum() -> int {
		var int total = 0;
		for( var auto it : values ) {
			total += it;
		}
		return total;
	}
}

func check_module() -> int {
	if( localValue() != 21 )
		return 1;
	return 0;
}

func check_class() -> int {
	var Container c;
	if( c.sum() != 6 )
		return 2;
	return 0;
}

func main() -> int {
	{
		var int result = check_module();
		if( result != 0 )
			return result;
	}
	{
		var int result = check_class();
		if( result != 0 )
			return result;
	}
	return 0;
}

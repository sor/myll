module class_template_operators;

class Ptr<T> {
	field T _value;

[pub]:
	[default] ctor();

	operator  *() -> T & =>  _value;
	operator ->() -> T * => &_value;
}

class Widget {
	field int _value = 42;

[pub]:
	[default] ctor();
	func value() -> int => _value;
}

func main() -> int
{
	var Ptr<Widget> p;

	if( p->value() != 42 )
		return 1;

	if( (*p).value() != 42 )
		return 2;

	var Widget w = *p;
	if( w.value() != 42 )
		return 3;

	return 0;
}

module local_multi_decl;

import std_initializer_list;

func main() -> int
{
	// inferred element types must not leak between accessors sharing one statement
	var ilist a = [1, 2], b = [3.5];
	if( a.size() != 2 ) return 1;
	if( b.size() != 1 ) return 2;

	var initlist<int> ai = [1, 2], bi = [3, 4];
	if( ai.size() != 2 ) return 3;
	if( bi.size() != 2 ) return 4;

	// plain types and the const qualifier are unchanged
	var int i = 3, j = 4;
	const ilist c = [1], d = [2.5];
	if( c.size() != 1 ) return 5;
	if( d.size() != 1 ) return 6;

	// sum of all sizes and values: 2+1+2+2+1+1+3+4 == 16
	return (int)a.size() + (int)b.size() + (int)ai.size() + (int)bi.size()
	     + (int)c.size() + (int)d.size() + i + j - 16;
}
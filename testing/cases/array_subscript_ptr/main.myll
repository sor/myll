module array_subscript_ptr;

func takesArray( const char *[] args ) -> bool
{
	return args[0] != null;
}

func identity( int argc, const char *[] argv ) -> int
{
	if( argc < 2 )
		return 0;

	// Address-of an element of an array-of-pointers has type const char**;
	// it should decay to the const char*[] parameter type.
	if( !takesArray( &argv[1] ) )
		return 0;
	if( argv[1] == null )
		return 0;

	return 0;
}

func main( int argc, const char *[] argv ) -> int
{
	return identity( argc, argv );
}

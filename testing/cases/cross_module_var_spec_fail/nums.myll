// The specialization guard case: two ODR violations are rejected as hard
// errors. (1) nums uses pi<int> but cannot see the specializations that
// spec_a and spec_b attach to it: its translation unit would instantiate
// the primary while theirs use the specialization. (2) spec_a and spec_b
// both specialize pi for int with different values.
module nums;

const T pi<T> = (T)3.1415;

func probe() -> int {
	var int p = pi<int>; // FAIL: 'pi' is specialized for T=int in module 'spec_a'
	return p;
}
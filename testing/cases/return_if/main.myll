module main;

func abs( int x ) -> int
{
	do return -x if( x < 0 );
	return x;
}

func sign( int x ) -> int
{
	do return  1 if( x > 0 );
	do return -1 if( x < 0 );
	return 0;
}

func maybeVoid( bool early ) -> void
{
	do return if( early );
}

func main() -> int
{
	if( abs( -5 ) != 5 ) return 1;
	if( abs(  3 ) != 3 ) return 2;

	if( sign( -7 ) != -1 ) return 3;
	if( sign(  0 ) !=  0 ) return 4;
	if( sign(  9 ) !=  1 ) return 5;

	maybeVoid( true );
	maybeVoid( false );

	return 0;
}

module dyn_array;

namespace Myll {

[ct] var usize DefaultCapacity = 8;

class DynArray<T> {
field {
	T[]!	_data;
	usize	_size     = 0;
	usize	_capacity = 0;
}

[pub]:
	ctor() : ctor( DefaultCapacity ) {}

	ctor( usize initialCapacity ) {
		_capacity = initialCapacity;
		if( initialCapacity > 0 )
			_data = new T[initialCapacity]!;
	}

	ctor initlist /*init*/ { // init is the default name, override by specifying it at instead of the /**/
		var const T* it   = init.begin();
		var const T* last = init.end();
		reserve( (usize)( last - it ) );
		while( it != last ) {
			pushBack( *it );
			++it;
		}
	}

	ctor move /*other*/ { // other is the default name
		_data     = (move)other._data;
		_size     = other._size;
		_capacity = other._capacity;
		other._data     = null;
		other._size     = 0;
		other._capacity = 0;
	}

	operator move = /*other*/ { // other is the default name
		if( &self == &other )
			return self;
		_data     = (move)other._data;
		_size     = other._size;
		_capacity = other._capacity;
		other._data     = null;
		other._size     = 0;
		other._capacity = 0;
		return self;
	}

	[chain]
	method reserve( usize newCapacity ) {
		if( newCapacity > _capacity ) {
			var T[]! new_data = new T[newCapacity]!;
			do _size times i {
				new_data[i] = _data[i];
			}
			_capacity = newCapacity;
			_data     = (move)new_data;
		}
	}

	[chain]
	method pushBack( const T& value ) {
		if( _size >= _capacity )
			grow();
		_data[_size] = value;
		++_size;
	}

	[chain]
	method popBack() {
		--_size;
	}

	[chain]
	method clear() {
		_size = 0;
	}

	[chain]
	method shrinkToFit() {
		if( _capacity > _size ) {
			if( _size == 0 ) {
				_data     = null;
				_capacity = 0;
			}
			else {
				var T[]! new_data = new T[_size]!;
				do _size times i {
					new_data[i] = _data[i];
				}
				_capacity = _size;
				_data     = (move)new_data;
			}
		}
	}

	[ct, pure]
	method size() -> usize => _size;

	[ct, pure]
	method capacity() -> usize => _capacity;

	[ct, pure]
	method isEmpty() -> bool => _size == 0;

	method at( usize index ) -> T& => _data[index];

	method front() -> T& => _data[0];

	method back() -> T& => _data[_size - 1];

	method top() -> T& => back();

	operator [] ( usize index ) -> T& => _data[index];

	[chain]
	method sort() {
		if( _size > 1 )
			sortRange( 0, _size - 1 );
	}

	[chain]
	method reverse() {
		if( _size == 0 )
			return self;
		var usize i = 0;
		var usize j = _size - 1;
		while( i < j ) {
			swap( i, j );
			++i;
			--j;
		}
	}

	[chain]
	method fill( const T& value ) {
		var usize i = 0;
		while( i < _size ) {
			_data[i] = value;
			++i;
		}
	}

	method find( const T& value ) -> Iterator {
		var usize i = 0;
		while( i < _size ) {
			if( _data[i] == value )
				return Iterator( &_data[i] );
			++i;
		}
		return end();
	}

	method binarySearch( const T& value ) -> bool {
		var usize left  = 0;
		var usize right = _size;
		while( left < right ) {
			var usize mid = left + ( right - left ) / 2;
			if( _data[mid] < value )
				left = mid + 1;
			else if( value < _data[mid] )
				right = mid;
			else
				return true;
		}
		return false;
	}

	method count( const T& value ) -> usize {
		var usize result = 0;
		var usize i      = 0;
		while( i < _size ) {
			if( _data[i] == value )
				++result;
			++i;
		}
		return result;
	}

	class Iterator {
	field {
		T* _ptr;
	}

	[pub]:
		ctor( T* ptr ) { _ptr = ptr; }

		[chain]
		method next() {
			++_ptr;
		}

		[pure]
		method value() -> T& => *_ptr;

		[pure]
		method equals( Iterator other ) -> bool => _ptr == other._ptr;

		operator ++ () -> Iterator& {
			++_ptr;
			return self;
		}

		operator * () -> T& => *_ptr;

		operator == ( Iterator other ) -> bool => _ptr == other._ptr;

		operator != ( Iterator other ) -> bool => _ptr != other._ptr;
	}

	method begin() -> Iterator {
		if( _size == 0 )
			return Iterator( null );
		return Iterator( &_data[0] );
	}

	method end() -> Iterator {
		if( _size == 0 )
			return Iterator( null );
		return Iterator( &_data[_size] );
	}

	method beginPtr() -> T* {
		if( _size == 0 )
			return null;
		return &_data[0];
	}

	method endPtr() -> T* {
		if( _size == 0 )
			return null;
		return &_data[_size];
	}

[priv]:
	method grow() {
		const usize new_capacity = _capacity == 0 ? 1 : _capacity * 2;
		reserve( new_capacity );
	}

	method swap( usize i, usize j ) {
		var T tmp   = _data[i];
		_data[i]    = _data[j];
		_data[j]    = tmp;
	}

	method sortRange( usize left, usize right ) {
		if( left < right ) {
			var usize pivot = partition( left, right );
			if( pivot > 0 )
				sortRange( left, pivot - 1 );
			sortRange( pivot + 1, right );
		}
	}

	method partition( usize left, usize right ) -> usize {
		var T     pivotValue = _data[right];
		var usize i          = left;
		var usize j          = left;
		while( j < right ) {
			if( _data[j] < pivotValue ) {
				swap( i, j );
				++i;
			}
			++j;
		}
		swap( i, right );
		return i;
	}
}

} // namespace Myll

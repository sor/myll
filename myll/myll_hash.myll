module myll_hash;

import myll_string;

namespace Myll {

// The Map/Set hash protocol: a free `hash` overload per key type. The
// containers call it unqualified from their template bodies — dependent
// arguments defer to C++, which picks the concrete overload at
// instantiation. User key types provide their own overload next to the
// type (same namespace, or found by ADL).


func hash( bool key ) -> u64 => key ? 1 : 0;


func hash( char key ) -> u64 => (u64)key;


func hash( u8 key ) -> u64 => (u64)key;


func hash( u16 key ) -> u64 => (u64)key;


func hash( u32 key ) -> u64 => (u64)key;


func hash( u64 key ) -> u64 => key;


func hash( i8 key ) -> u64 => (u64)(u8)key;


func hash( i16 key ) -> u64 => (u64)(u16)key;


func hash( i32 key ) -> u64 => (u64)(u32)key;


func hash( i64 key ) -> u64 => (u64)key;

// FNV-1a over the bytes.
func hash( Myll::StringView view ) -> u64 {
	var u64 result = 14695981039346656037;
	do view.len() times i {
		result = result ^ (u64)view.at( i );
		result = result * 1099511628211;
	}
	return result;
}

func hash( Myll::String str ) -> u64 => Myll::hash( str.view() );

} // namespace Myll